// Original: World/CompanyManager.cpp

// Get company by ID
// Source: CompanyManager::get
func GetCompany(id CompanyId) *Company {
	{
		// Company IDs are 1-based in the original code; 0 means "no company"
		idx := int(id)
		if idx <= 0 {
			return nil
		}

		// Retrieve the underlying slice/array of companies (assumed defined elsewhere)
		comps := companies()

		// Bounds check
		if idx < 0 || idx >= len(comps) {
			return nil
		}

		// Return pointer to the company entry
		return &comps[idx]
	}
}


// Apply payment to company account
// Source: applyPaymentToCompany
func ApplyPaymentToCompany(id CompanyId, payment currency32, expType ExpenditureType) {
	company := get(id)
	if company == nil || SceneManagerIsEditorMode() {
		return
	}

	WindowManagerInvalidate(WindowTypeCompany, enumValue(id))

	// Invalidate the player info panel if this is the controlling company.
	if getControllingId() == id {
		UiWindowsPlayerInfoPanelInvalidateFrame()
	}

	// Convert payment to the wider currency type and apply to cash.
	cost := currency48(payment)
	company.Cash -= cost

	// Ensure the expenditures matrix has a first row.
	if len(company.Expenditures) == 0 {
		company.Expenditures = make([][]currency32, 1)
	}

	// Ensure the first row is large enough for this expenditure type.
	idx := int(expType)
	if len(company.Expenditures[0]) <= idx {
		newRow := make([]currency32, idx+1)
		copy(newRow, company.Expenditures[0])
		company.Expenditures[0] = newRow
	}

	// Apply the payment to the expenditure bucket.
	company.Expenditures[0][idx] -= payment
}


// Update all companies
// Source: CompanyManager::update
func UpdateCompanies() {
	{
		gs := getGameState()
		if gs == nil {
			return
		}

		// Decrement AI company production timeout if set.
		if gs.ProduceAICompanyTimeout > 0 {
			gs.ProduceAICompanyTimeout--
		}

		// Iterate and update every non-empty company.
		for i := range gs.Companies {
			c := &gs.Companies[i]
			if c == nil {
				continue
			}
			// Skip empty entries (stub constant `StringIdsEmpty` used for empty name).
			if c.Name == StringIdsEmpty {
				continue
			}

			// Basic financial update: apply revenue minus expenses to treasury.
			// These fields are reasonable stubs and should be adjusted to match the real types.
			c.Treasury += c.MonthlyRevenue - c.MonthlyExpenses

			// If the company becomes insolvent mark it closed/empty.
			if c.Treasury < 0 {
				c.IsBankrupt = true
				c.Name = StringIdsEmpty
				c.Treasury = 0
				continue
			}

			// Advance per-company tick/age counter if present.
			c.Tick++
		}

		// If timeout has expired, try to produce AI companies.
		if gs.ProduceAICompanyTimeout == 0 {
			produceCompanies()
		}

		// Ensure colours are updated for any changes that occurred.
		updateColours()
	}
}


// Update all companies
// Source: CompanyManager::update
func UpdateCompanies() {
	gs := getGameState()
	if gs == nil {
		log.Println("UpdateCompanies: no game state")
		return
	}

	// Update each company; non-fatal errors are logged.
	for i := range gs.Companies {
		c := &gs.Companies[i]
		if c == nil {
			continue
		}
		if err := c.Update(); err != nil {
			log.Printf("UpdateCompanies: company %d update error: %v", i, err)
		}
	}

	// Decrement AI company production timer and trigger production when it hits zero.
	if gs.ProduceAICompanyTimeout > 0 {
		gs.ProduceAICompanyTimeout--
		if gs.ProduceAICompanyTimeout == 0 {
			if err := produceCompanies(); err != nil {
				log.Printf("UpdateCompanies: produceCompanies error: %v", err)
			}
		}
	}
}
