// Paint station element
// Source: paintStation
func PaintStation(session *PaintSession, element *StationElement) {
	{
		// Basic nil checks
		if session == nil || element == nil {
			return
		}

		// If the element is a ghost, nothing to paint.
		if element.IsGhost() {
			return
		}

		// Respect render target zoom: only draw at base zoom (zoomLevel == 0).
		if rt := session.GetRenderTarget(); rt != nil && rt.ZoomLevel > 0 {
			return
		}

		// Resolve the station instance for this element; if missing, nothing to do.
		station := StationManagerGet(element.StationID())
		if station == nil {
			return
		}

		// Resolve the station object (determines whether it's train/road/airport/dock).
		obj := ObjectManagerGetStationObject(element.ObjectID())

		// Dispatch to the appropriate painter based on the station object type.
		// Use a conservative default to train-station painting when unknown.
		if obj == nil {
			PaintTrainStation(session, element)
			return
		}

		switch obj.Class() {
		case "train":
			PaintTrainStation(session, element)
		case "road":
			PaintRoadStation(session, element)
		case "airport":
			PaintAirport(session, element)
		case "dock":
			PaintDocks(session, element)
		default:
			// Unknown class — fall back to train station painter.
			PaintTrainStation(session, element)
		}
	}
}


// Paint station element
// Source: paintStation
func PaintStation(session *PaintSession, element *StationElement) {
	// guard against nil inputs
	if session == nil || element == nil {
		return
	}

	// Ghost stations are not drawn
	if element.IsGhost() {
		return
	}

	// Dispatch to the appropriate station painter based on station type
	switch element.Type() {
	case TrainStationType:
		PaintTrainStation(session, element)
	case RoadStationType:
		PaintRoadStation(session, element)
	case DockStationType:
		PaintDocks(session, element)
	case AirportStationType:
		PaintAirport(session, element)
	default:
		// Unknown station type — nothing to paint
	}
}
