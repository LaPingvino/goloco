// Main paint generation loop - iterates viewport tiles and generates paint structures
// Source: PaintSession::generate
func (ps *PaintSession) Generate() {
	// Guard against missing render target
	if ps == nil || ps.RenderTarget == nil {
		return
	}

	rt := ps.RenderTarget
	rotation := ps.Rotation & 3

	// Calculate number of vertical quadrants using same constants as original
	add := 1056
	if rotation == 0 {
		add = 1040
	}
	numVerticalQuadrants := int((rt.Height + add) >> 5)

	// Convert viewport origin to map coordinates and snap to 32-grid
	mapLoc := UiViewportCoordToMapCoord(
		floor2(rt.X, 32),
		floor2(rt.Y-16, 32),
		0,
		int(rotation),
	)
	if rotation&1 == 1 {
		mapLoc.Y -= 16
	}
	mapLoc.X = floor2(mapLoc.X, 32)
	mapLoc.Y = floor2(mapLoc.Y, 32)

	// Precompute rotated quadrant offsets
	dir := directionFlipXAxis(int(rotation))
	additionalQuadrants := [5]WorldPos2{
		rotatePos(WorldPos2{X: -32, Y: 32}, dir),
		rotatePos(WorldPos2{X: 0, Y: 32}, dir),
		rotatePos(WorldPos2{X: 32, Y: 0}, dir),
		rotatePos(WorldPos2{X: 32, Y: -32}, dir),
		rotatePos(WorldPos2{X: -32, Y: 64}, dir),
	}
	nextVerticalQuadrant := rotatePos(WorldPos2{X: 32, Y: 32}, dir)

	// Prepare output container
	ps.Paints = ps.Paints[:0]

	// Main generation loop: walk vertical quadrants, then the 5 sub-quadrants per column
	for v := 0; v < numVerticalQuadrants; v++ {
		// base origin for this vertical quadrant
		base := WorldPos2{
			X: mapLoc.X + nextVerticalQuadrant.X*v,
			Y: mapLoc.Y + nextVerticalQuadrant.Y*v,
		}

		// For each of the five quadrant offsets, generate paint entries
		for i := 0; i < len(additionalQuadrants); i++ {
			offset := additionalQuadrants[i]
			tileOrigin := WorldPos2{
				X: base.X + offset.X,
				Y: base.Y + offset.Y,
			}

			// Create a paint entry for this tile region.
			// Details like tile content, tunnels, and decorations are filled
			// by helper routines that operate on the map at `tileOrigin`.
			paint := Paint{}
			paint.Origin = tileOrigin

			// Populate paint with geometry and metadata.
			// These helper functions encapsulate complex logic (terrain, buildings, tunnels).
			populateTerrain(&paint, rt, tileOrigin, rotation)
			populateObjects(&paint, rt, tileOrigin, rotation)
			populateTunnels(&paint, rt, tileOrigin, rotation)

			ps.Paints = append(ps.Paints, paint)
		}
	}
}


// Draw all arranged paint structures to the render target
// Source: PaintSession::drawStructs
func (ps *PaintSession) DrawStructs(dc *DrawingContext) {
	{
		// Guard against nil receiver/context
		if ps == nil || dc == nil {
			return
		}

		rt := dc.CurrentRenderTarget()

		// Iterate over arranged paint structs
		for p := ps.paintHead; p != nil; p = p.nextQuadrantPS {
			shouldCull := shouldTryCullPaintStruct(p, ps.viewFlags)

			if shouldCull {
				if cullPaintStructImage(p.imageId, ps.viewFlags) {
					continue
				}
			}

			drawStruct(rt, dc, p, shouldCull)

			// Draw chained children (each child's .children links to the next child)
			for child := p.children; child != nil; child = child.children {
				shouldCullChild := shouldTryCullPaintStruct(child, ps.viewFlags)

				if shouldCullChild {
					if cullPaintStructImage(child.imageId, ps.viewFlags) {
						continue
					}
				}

				drawStruct(rt, dc, child, shouldCullChild)

				// Draw attachments for this child
				drawAllAttachedStructs(rt, dc, child, ps.viewFlags)
			}

			// Draw attachments for the top-level struct
			drawAllAttachedStructs(rt, dc, p, ps.viewFlags)
		}
	}
}


// Sort paint structures by depth for proper rendering order
// Source: PaintSession::arrangeStructs
func (ps *PaintSession) ArrangeStructs() {
	// Quick no-op if there's nothing to arrange.
	if ps == nil {
		return
	}
	head := ps.firstPaintStruct
	if head == nil {
		return
	}

	// Helper: bounding box check per rotation.
	checkBoundingBox := func(rotation uint8, initial, current PaintStructBoundBox) bool {
		switch rotation {
		case 0:
			if initial.Maxs.Z >= current.Mins.Z && initial.Maxs.Y >= current.Mins.Y && initial.Maxs.X >= current.Mins.X &&
				!(initial.Mins.Z < current.Maxs.Z && initial.Mins.Y < current.Maxs.Y && initial.Mins.X < current.Maxs.X) {
				return true
			}
		case 1:
			if initial.Maxs.Z >= current.Mins.Z && initial.Maxs.Y >= current.Mins.Y && initial.Maxs.X < current.Mins.X &&
				!(initial.Mins.Z < current.Maxs.Z && initial.Mins.Y < current.Maxs.Y && initial.Mins.X >= current.Maxs.X) {
				return true
			}
		case 2:
			if initial.Maxs.Z >= current.Mins.Z && initial.Maxs.Y < current.Mins.Y && initial.Maxs.X < current.Mins.X &&
				!(initial.Mins.Z < current.Maxs.Z && initial.Mins.Y >= current.Maxs.Y && initial.Mins.X >= current.Maxs.X) {
				return true
			}
		case 3:
			if initial.Maxs.Z >= current.Mins.Z && initial.Maxs.Y < current.Mins.Y && initial.Maxs.X >= current.Mins.X &&
				!(initial.Mins.Z < current.Maxs.Z && initial.Mins.Y >= current.Maxs.Y && initial.Mins.X < current.Maxs.X) {
				return true
			}
		}
		return false
	}

	// Core reordering helper for a given rotation and quadrant index.
	arrangeHelper := func(psNext *PaintStruct, quadrantIndex uint16, flag QuadrantFlags, rotation uint8) *PaintStruct {
		var ps *PaintStruct

		// Find the first node in the specified quadrant range.
		for {
			ps = psNext
			psNext = psNext.nextQuadrantPS
			if psNext == nil {
				return ps
			}
			if !(quadrantIndex > psNext.quadrantIndex) {
				break
			}
		}

		// Entry for this quadrant so callers can resume from here later.
		psQuadrantEntry := ps

		// Mark relevancy flags for nodes in the list.
		psTemp := ps
		for {
			ps = ps.nextQuadrantPS
			if ps == nil {
				break
			}
			if ps.quadrantIndex > quadrantIndex+1 {
				ps.quadrantFlags = QuadrantFlagsOutsideQuadrant
			} else if ps.quadrantIndex == quadrantIndex+1 {
				ps.quadrantFlags = QuadrantFlagsNeighbour | QuadrantFlagsPendingVisit
			} else if ps.quadrantIndex == quadrantIndex {
				ps.quadrantFlags = flag | QuadrantFlagsPendingVisit
			}
			if !(ps.quadrantIndex <= quadrantIndex+1) {
				break
			}
		}
		ps = psTemp

		// Iterate and reorder nodes within the quadrant according to bounding boxes.
		for {
			// Find first pendingVisit node in the quadrant list.
			for {
				psNext = ps.nextQuadrantPS
				if psNext == nil {
					// End of list
					return psQuadrantEntry
				}
				if psNext.hasQuadrantFlags(QuadrantFlagsOutsideQuadrant) {
					// Reached outside of current quadrant range
					return psQuadrantEntry
				}
				if psNext.hasQuadrantFlags(QuadrantFlagsPendingVisit) {
					// Found a node to visit
					break
				}
				ps = psNext
			}

			// Mark visited (clear pending flag).
			psNext.quadrantFlags &^= QuadrantFlagsPendingVisit
			psTemp = ps

			// Compare current node against following neighbour nodes.
			initialBBox := psNext.bounds
			for {
				ps = psNext
				psNext = psNext.nextQuadrantPS
				if psNext == nil {
					break
				}
				if psNext.hasQuadrantFlags(QuadrantFlagsOutsideQuadrant) {
					break
				}
				if !psNext.hasQuadrantFlags(QuadrantFlagsNeighbour) {
					continue
				}

				currentBBox := psNext.bounds
				if checkBoundingBox(rotation, initialBBox, currentBBox) {
					// Move intersecting child behind psTemp
					ps.nextQuadrantPS = psNext.nextQuadrantPS
					ps_temp2 := psTemp.nextQuadrantPS
					psTemp.nextQuadrantPS = psNext
					psNext.nextQuadrantPS = ps_temp2
					// Continue scanning from ps (which now points to the previous node)
					psNext = ps
				}
			}

			// Reset ps to the saved temporary entry for next iteration.
			ps = psTemp
		}
	}

	// Iterate over 4 rotations and 4 quadrant indices, reorganising the list.
	// Use a simple mapping for per-quadrant flag bits; callers can override actual flag values.
	for rotation := uint8(0); rotation < 4; rotation++ {
		for quadrantIndex := uint16(0); quadrantIndex < 4; quadrantIndex++ {
			// Use a bit flag corresponding to the quadrant index to mark nodes in that quadrant.
			flag := QuadrantFlags(1 << quadrantIndex)
			if head == nil {
				break
			}
			head = arrangeHelper(head, quadrantIndex, flag, rotation)
		}
	}

	// Save reordered head back to session.
	ps.firstPaintStruct = head
}


// Create new paint session
// Source: PaintSession::PaintSession
func NewPaintSession(rt *RenderTarget, options *SessionOptions) *PaintSession {
	if options == nil {
		// Use zero-value defaults when options are not provided.
		options = &SessionOptions{}
	}

	ps := &PaintSession{}

	// Associate the render target
	ps.renderTarget = rt

	// Clear session pointers (zero values are nil by default, set explicitly for clarity)
	ps.lastPS = nil
	ps.lastPaintString = nil
	ps.paintStringHead = nil

	// Quadrants are zero-initialized (nil) by default; this mirrors setting each to nullptr in C++.

	// Set back/front indices. Use bitwise complement to produce max uint32.
	ps.quadrantBackIndex = ^uint32(0)
	ps.quadrantFrontIndex = 0

	// Copy options into the session
	ps.viewFlags = options.viewFlags
	ps.currentRotation = options.rotation
	ps.isHitTest = options.isHitTest
	ps.skipTrackRoadSurfaces = options.skipTrackRoadSurfaces
	ps.foregroundCullingHeight = options.foregroundCullHeight

	return ps
}
