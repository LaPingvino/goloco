// Paint tree element
// Source: paintTree
func PaintTree(session *PaintSession, element *TreeElement) {
	session.SetItemType(InteractionItemTree)

	treeObj := ObjectManagerGetTreeObject(element.TreeObjectID())

	// rotation and frame calculation
	viewableRotation := (session.GetRotation() + element.Rotation()) & 0x3
	treeFrameNum := uint32(viewableRotation%int(treeObj.NumRotations)) + uint32(element.Growth())*uint32(treeObj.NumRotations)

	// season / secondary image bookkeeping
	seasonMap := []uint8{3, 0, 1, 2, 1, 4}
	image2Swap := []bool{true, true, false, false, true, true}
	quadOffsets := []Pos2{
		{X: 7, Y: 7},
		{X: 7, Y: 23},
		{X: 23, Y: 23},
		{X: 23, Y: 7},
	}

	season := element.Season()
	hasImage2 := false
	var imageIndex2 uint32
	var noiseMask uint8

	if element.Unk7L() != 7 {
		hasImage2 = true

		season = seasonMap[season]
		noiseMask = uint8(element.Unk7L()) + 1
		image2Season := element.Season()

		if image2Swap[image2Season] {
			// swap seasons and invert noise mask as in original logic
			image2Season = season
			season = element.Season()
			noiseMask = 8 - noiseMask
		}

		var imageId uint32
		if element.HasSnow() {
			imageId = treeObj.SnowSprites[image2Season]
		} else {
			imageId = treeObj.Sprites[image2Season]
		}
		imageIndex2 = treeFrameNum + imageId
	}

	var seasonBaseImageIndex uint32
	if element.HasSnow() {
		seasonBaseImageIndex = treeObj.SnowSprites[season]
	} else {
		seasonBaseImageIndex = treeObj.Sprites[season]
	}

	// shadow image (optional)
	var shadowImageId *ImageId
	if treeObj.HasFlags(TreeObjectFlagsHasShadow) {
		img := NewImageId(treeObj.ShadowImageOffset + treeFrameNum + seasonBaseImageIndex).WithTranslucency(ExtColourUnk32)
		shadowImageId = &img
	}

	// quadrant-based offset
	quadrant := (element.Quadrant() + session.GetRotation()) % 4
	imageOffset := Pos3{
		X: quadOffsets[quadrant].X,
		Y: quadOffsets[quadrant].Y,
		Z: element.BaseHeight(),
	}

	// bounding box Z size (clamped and scaled)
	boundBoxSizeZ := (minInt(element.ClearZ()-element.BaseZ(), 32) * WorldKSmallZStep) - 3

	imageIndex1 := treeFrameNum + seasonBaseImageIndex

	var imageId1 ImageId
	var imageId2 ImageId

	if element.IsGhost() {
		// ghost items have no interaction and use ghosted images
		session.SetItemType(InteractionItemNoInteraction)
		imageId2 = GfxApplyGhostToImage(imageIndex2)
		imageId1 = GfxApplyGhostToImage(imageIndex1)
	} else if treeObj.Colours != 0 {
		// coloured tree variation
		colour := Colour(element.Colour())
		imageId2 = NewImageIdWithColour(imageIndex2, colour).WithNoiseMask(noiseMask)
		imageId1 = NewImageIdWithColour(imageIndex1, colour)
	} else {
		imageId1 = NewImageId(imageIndex1)
		imageId2 = NewImageId(imageIndex2).WithNoiseMask(noiseMask)
	}

	// render shadow if present and zoom level allows
	if shadowImageId != nil {
		if session.GetRenderTarget().ZoomLevel <= 1 {
			session.AddToPlotListAsParent(*shadowImageId, imageOffset, Pos3{X: imageOffset.X, Y: imageOffset.Y, Z: imageOffset.Z}, Pos3{X: 18, Y: 18, Z: 1})
		}
	}

	// add primary image (parent)
	session.AddToPlotListAsParent(imageId1, imageOffset, Pos3{X: imageOffset.X, Y: imageOffset.Y, Z: imageOffset.Z + 2}, Pos3{X: 2, Y: 2, Z: boundBoxSizeZ})

	// add secondary image (child) if present
	if hasImage2 {
		session.AddToPlotListAsChild(imageId2, imageOffset, Pos3{X: imageOffset.X, Y: imageOffset.Y, Z: imageOffset.Z + 2}, Pos3{X: 2, Y: 2, Z: boundBoxSizeZ})
	}

	// helper: integer min
	func minInt(a, b int) int {
		if a < b {
			return a
		}
		return b
	}
}


// Paint tree element
// Source: paintTree
func PaintTree(session *PaintSession, element *TreeElement) {
	{
		// Set interaction for this item
		session.SetItemType(InteractionItemTree)

		// Retrieve object definition for this tree
		treeObj := ObjectManagerGetTreeObject(element.TreeObjectID())

		// Compute frame based on rotation and growth
		viewableRotation := (session.GetRotation() + element.Rotation()) & 0x3
		treeFrameNum := (viewableRotation % treeObj.NumRotations) + element.Growth()*treeObj.NumRotations

		// Season/image handling
		season := element.Season()
		hasImage2 := false
		var imageIndex2 int
		var noiseMask int

		// Transliteration of the C++ lookup tables
		seasonMap := []int{3, 0, 1, 2, 1, 4}
		image2Swap := []bool{true, true, false, false, true, true}

		if element.Unk7l() != 7 {
			hasImage2 = true

			season = seasonMap[int(season)]
			noiseMask = int(element.Unk7l()) + 1
			image2Season := element.Season()

			// If this season index indicates a swap, perform it and adjust noise mask
			if image2Swap[int(image2Season)] {
				image2Season = season
				season = element.Season()
				noiseMask = 8 - noiseMask
			}

			var imageIdFor2 int
			if element.HasSnow() {
				imageIdFor2 = treeObj.SnowSprites[int(image2Season)]
			} else {
				imageIdFor2 = treeObj.Sprites[int(image2Season)]
			}
			imageIndex2 = treeFrameNum + imageIdFor2
		}

		// Base image index for the primary image
		var seasonBaseImageIndex int
		if element.HasSnow() {
			seasonBaseImageIndex = treeObj.SnowSprites[int(season)]
		} else {
			seasonBaseImageIndex = treeObj.Sprites[int(season)]
		}

		// Optional shadow image
		var shadowImage *ImageId
		if treeObj.HasFlags(TreeObjectFlagHasShadow) {
			id := ImageIdFromIndex(treeObj.ShadowImageOffset + treeFrameNum + seasonBaseImageIndex).WithTranslucency(ExtColourUnk32)
			shadowImage = &id
		}

		// Compute quadrant-based drawing offset
		kTreeQuadrantOffset := []Pos2{
			{X: 7, Y: 7},
			{X: 7, Y: 23},
			{X: 23, Y: 23},
			{X: 23, Y: 7},
		}
		quadrant := (element.Quadrant() + session.GetRotation()) % 4
		imageOffset := Pos3{
			X: kTreeQuadrantOffset[quadrant].X,
			Y: kTreeQuadrantOffset[quadrant].Y,
			Z: element.BaseHeight(),
		}

		// Bounding box Z-size (clamped to 32 then scaled)
		diffZ := element.ClearZ() - element.BaseZ()
		if diffZ > 32 {
			diffZ = 32
		}
		boundBoxSizeZ := diffZ*WorldKSmallZStep - 3

		// Prepare image ids
		imageIndex1 := treeFrameNum + seasonBaseImageIndex
		var imageId1 ImageId
		var imageId2 ImageId

		if element.IsGhost() {
			// Ghost objects don't receive interaction
			session.SetItemType(InteractionItemNoInteraction)
			imageId2 = ApplyGhostToImage(imageIndex2)
			imageId1 = ApplyGhostToImage(imageIndex1)
		} else if treeObj.Colours != 0 {
			// Coloured tree variant (rare)
			colour := Colour(element.Colour())
			imageId2 = NewImageIdWithColour(imageIndex2, colour).WithNoiseMask(noiseMask)
			imageId1 = NewImageIdWithColour(imageIndex1, colour)
		} else {
			// Default path
			imageId1 = NewImageId(imageIndex1)
			imageId2 = NewImageId(imageIndex2).WithNoiseMask(noiseMask)
		}

		// Draw shadow first (as parent) if present and zoom is appropriate
		if shadowImage != nil {
			if session.GetRenderTarget().ZoomLevel() <= 1 {
				session.AddToPlotListAsParent(*shadowImage, imageOffset, imageOffset, Bounds3{X: 18, Y: 18, Z: 1})
			}
		}

		// Primary image (parent)
		imageOffsetPlus := Pos3{X: imageOffset.X, Y: imageOffset.Y, Z: imageOffset.Z + 2}
		session.AddToPlotListAsParent(imageId1, imageOffset, imageOffsetPlus, Bounds3{X: 2, Y: 2, Z: boundBoxSizeZ})

		// Secondary image (child) if present
		if hasImage2 {
			session.AddToPlotListAsChild(imageId2, imageOffset, imageOffsetPlus, Bounds3{X: 2, Y: 2, Z: boundBoxSizeZ})
		}
	}
}
