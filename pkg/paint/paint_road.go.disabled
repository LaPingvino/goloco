			session.AddToPlotList4FD150(image3, heightOffset, bbOffset, bbSize)
		} else {
			bbOffset := addPos(World.Pos3{X: 30, Y: 17, Z: 1}, heightOffset)
			bbSize := World.Pos3{X: 1, Y: 14, Z: 8}
			session.AddToPlotList4FD150(image3, heightOffset, bbOffset, bbSize)
