			{X: 15, Y: 2, Z: 0},
		}
		kStreetlightBoundingBoxOffsets := [4]World.Pos3{
			{X: 2, Y: 15, Z: 6},
			{X: 15, Y: 28, Z: 6},
			{X: 28, Y: 15, Z: 6},
			{X: 15, Y: 2, Z: 6},
		}
		kStreetlightBoundingBoxSizes := World.Pos3{X: 1, Y: 1, Z: 6}

		// If the road element has a streetlight, render it
		if elRoad.HasStreetlight {
			style := int(elRoad.StreetlightStyle)
			// keep style in-bounds
			if style < 0 || style >= len(kStreetlightImageFromStyle) {
				style = 0
