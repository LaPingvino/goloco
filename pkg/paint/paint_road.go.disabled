		// Small helper for adding Pos3 values (assumes World.Pos3 has X, Y, Z fields)
		addPos := func(a, b World.Pos3) World.Pos3 {
			return World.Pos3{a.X + b.X, a.Y + b.Y, a.Z + b.Z}
		}

		// Normalise rotation to 0..3 (assumes Rotation is a uint8-like bitmask)
		rotation := uint8(elRoad.Rotation) & 0x3

		// Compute a base height offset (assumes elRoad.BaseHeight exists)
		baseHeight := int16(elRoad.BaseHeight)
		heightOffset := World.Pos3{X: 0, Y: 0, Z: baseHeight}

		// Example sprite/image used earlier in the original function
