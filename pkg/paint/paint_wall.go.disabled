// Paint wall/fence element
// Source: paintWall
func PaintWall(session *PaintSession, element *WallElement) {
	{
		// Lookup the wall object; mirror the original assert by panicking if missing.
		wallObject := ObjectManagerGetWallObject(element.WallObjectID())
		if wallObject == nil {
			panic("paintWall: wall object not found")
		}

		isGhost := element.IsGhost()
		if isGhost {
			session.SetItemType(InteractionItemNoInteraction)
		} else {
			session.SetItemType(InteractionItemWall)
		}

		// Calculate object and rotation based values.
		objectHeight := kSmallZStep*wallObject.Height - 2
		rotation := (session.GetRotation() + element.Rotation()) & 0x3

		// Height offset from element base.
		heightOffset := Pos3{X: 0, Y: 0, Z: element.BaseHeight()}

		// Add the height offset to the canonical offsets for this rotation.
		offset := kOffsets[rotation]
		offset.X += heightOffset.X
		offset.Y += heightOffset.Y
		offset.Z += heightOffset.Z

		bboxOffset := kBBoxOffsets[rotation]
		bboxOffset.X += heightOffset.X
		bboxOffset.Y += heightOffset.Y
		bboxOffset.Z += heightOffset.Z

		// bboxLength adds the object height in Z only.
		bboxLength := kBBoxLengths[rotation]
		bboxLength.Z += objectHeight

		// Image selection
		isTwoSided := (wallObject.Flags & WallObjectFlagsTwoSided) != 0
		imageOffset := getWallImageIndexOffset(element, rotation, isTwoSided)
		imageIndex := wallObject.Sprite + imageOffset

		// If the wall has glass, we add a parent image and (for non-ghosts) a translucent child.
		if (wallObject.Flags & WallObjectFlagsHasGlass) != 0 {
			imageId := getWallImageId(imageIndex, isGhost, element, wallObject)
			session.AddToPlotListAsParent(imageId, offset, bboxOffset, bboxLength)

			if !isGhost {
				blendColour := ColoursGetGlass(imageId.GetPrimary())
				glassImageIndex := wallObject.Sprite + getWallImageIndexOffsetGlass(element, rotation)
				session.AddToPlotListAsChild(NewImageId(glassImageIndex).WithTranslucency(blendColour), offset, bboxOffset, bboxLength)
			}
			return
		}

		// Default (no glass) path: add single parent image.
		imageId := getWallImageId(imageIndex, isGhost, element, wallObject)
		session.AddToPlotListAsParent(imageId, offset, bboxOffset, bboxLength)
	}
}


// Paint wall/fence element
// Source: paintWall
func PaintWall(session *PaintSession, element *WallElement) {
	{
		// Retrieve wall object; return on error.
		wallObject, err := ObjectManagerGetWallObject(element.WallObjectID())
		if err != nil || wallObject == nil {
			return
		}

		isGhost := element.IsGhost()
		if isGhost {
			session.SetItemType(InteractionItemNoInteraction)
		} else {
			session.SetItemType(InteractionItemWall)
		}

		// Compute object height and rotation (rotation constrained to 0..3).
		objectHeight := int32(kSmallZStep*int(wallObject.Height) - 2)
		rotation := (session.GetRotation() + element.Rotation()) & 0x3

		heightOffset := Pos3{X: 0, Y: 0, Z: element.BaseHeight()}

		// Offsets / bounding boxes (assume Pos3 has Add method).
		offset := kOffsets[rotation].Add(heightOffset)
		bboxOffset := kBBoxOffsets[rotation].Add(heightOffset)
		bboxLength := kBBoxLengths[rotation].Add(Pos3{X: 0, Y: 0, Z: objectHeight})

		isTwoSided := (wallObject.Flags & WallObjectFlagsTwoSided) != 0

		imageOffset := getWallImageIndexOffset(element, rotation, isTwoSided)
		imageIndex := ImageIndex(int(wallObject.Sprite) + int(imageOffset))

		// If wall has glass, draw base as parent and glass as translucent child.
		if (wallObject.Flags & WallObjectFlagsHasGlass) != 0 {
			imageId := getWallImageId(imageIndex, isGhost, element, wallObject)
			session.AddToPlotListAsParent(imageId, offset, bboxOffset, bboxLength)

			if !isGhost {
				blendColour := ColoursGetGlass(imageId.GetPrimary())
				glassImageIndex := ImageIndex(int(wallObject.Sprite) + int(getWallImageIndexOffsetGlass(element, rotation)))
				session.AddToPlotListAsChild(glassImageIndex.WithTranslucency(blendColour), offset, bboxOffset, bboxLength)
			}
			return
		}

		// Non-glass wall: draw only the base image as parent.
		imageId := getWallImageId(imageIndex, isGhost, element, wallObject)
		session.AddToPlotListAsParent(imageId, offset, bboxOffset, bboxLength)
	}
}
