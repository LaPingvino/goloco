// Paint vehicle sprite
// Source: paintVehicleEntity
func PaintVehicleEntity(session *PaintSession, vehicle *VehicleBase) {
	{
		// nil-safety
		if session == nil || vehicle == nil {
			return
		}

		// If this is a ghost vehicle and it's not owned by the controlling company, skip painting.
		if vehicle.Has38Flags(Flags38IsGhost) {
			if vehicle.Owner != CompanyManagerGetControllingID() {
				return
			}
		}

		switch vehicle.GetSubType() {
		case VehicleEntityTypeHead, VehicleEntityTypeVehicle1, VehicleEntityTypeVehicle2, VehicleEntityTypeTail:
			// These entity types don't require additional painting here.
			return
		case VehicleEntityTypeBogie:
			if bogie := vehicle.AsVehicleBogie(); bogie != nil {
				PaintBogie(session, bogie)
			}
		case VehicleEntityTypeBodyStart, VehicleEntityTypeBodyContinued:
			if body := vehicle.AsVehicleBody(); body != nil {
				PaintBody(session, body)
			}
		}
	}
}


// Paint vehicle sprite
// Source: paintVehicleEntity
func PaintVehicleEntity(session *PaintSession, vehicle *VehicleBase) {
	if session == nil || vehicle == nil {
		return
	}

	// If vehicle is a ghost and not owned by the controlling company, skip painting.
	if vehicle.Has38Flags(Flags38IsGhost) {
		if vehicle.Owner != GetControllingCompanyID() {
			return
		}
	}

	switch vehicle.GetSubType() {
	case VehicleEntityTypeHead, VehicleEntityTypeVehicle1, VehicleEntityTypeVehicle2, VehicleEntityTypeTail:
		// Nothing to paint for these types here.
	case VehicleEntityTypeBogie:
		if bogie := vehicle.AsVehicleBogie(); bogie != nil {
			paintBogie(session, bogie)
		}
	case VehicleEntityTypeBodyStart, VehicleEntityTypeBodyContinued:
		if body := vehicle.AsVehicleBody(); body != nil {
			paintBody(session, body)
		}
	}
}
