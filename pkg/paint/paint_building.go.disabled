// Paint building element
// Source: paintBuilding
func PaintBuilding(session *PaintSession, element *BuildingElement) {
	{
		// Determine ticks and construction state
		ticks := ScenarioManagerGetScenarioTicks()
		numSections := uint8(0xF0) // 0xF0 == all sections completed
		var sectionProgress uint8 = 0
		if !element.IsConstructed() {
			ticks = 0
			numSections = element.Age()
			sectionProgress = element.SectionProgress()
		}

		// Fetch object and variation data
		variation := element.Variation()
		buildingObj := element.BuildingObject()
		parts := buildingObj.GetBuildingParts(variation)

		// Compute total section height when building is under construction
		var totalSectionHeight uint8 = 0
		if numSections != 0xF0 {
			sectionCount := int8(numSections)
			partHeights := buildingObj.GetBuildingPartHeights()
			for _, part := range parts {
				totalSectionHeight += partHeights[part]
				sectionCount--
				if sectionCount == -1 {
					// Ensure at least 1 height if we truncated early
					if totalSectionHeight < 1 {
						totalSectionHeight = 1
					}
					break
				}
			}
		}

		// Short aliases and layout info (assume element provides these)
		imageOffset := element.ImageOffset()
		bbOffset := element.BBOffset()
		bbSize := element.BBSize()
		baseColour := element.BaseColour()
		rotation := element.Rotation()
		isMultiTile := element.IsMultiTile()

		// Scaffolding before building parts (stack from bottom)
		scaffoldingColour := buildingObj.ScaffoldingColour
		scaffSegType := buildingObj.ScaffoldingSegmentType
		if totalSectionHeight != 0 && scaffSegType != 0xFF {
			scaffObj := ObjectManagerGetScaffoldingObject()
			segmentHeight := scaffObj.SegmentHeights[scaffSegType]
			var scaffImages ScaffoldingImagesRef
			if isMultiTile {
				scaffImages = GetScaffoldingImages(scaffSegType).Get2x2()
			} else {
				scaffImages = GetScaffoldingImages(scaffSegType).Get1x1()
			}

			baseScaffImageIdx := scaffObj.Image
			var baseScaffImage ImageId
			if element.IsGhost() {
				baseScaffImage = ApplyGhostToImage(baseScaffImageIdx)
			} else {
				baseScaffImage = NewImageId(baseScaffImageIdx, scaffoldingColour)
			}

			scaffImage := baseScaffImage.WithIndexOffset(scaffImages.Back)
			segmentImageOffset := imageOffset
			// Stack segments until we've covered the building height
			for remaining := int(totalSectionHeight); remaining > 0; remaining -= int(segmentHeight) {
				session.AddToPlotListAsChild(scaffImage, segmentImageOffset, bbOffset, bbSize)
				segmentImageOffset.Z += segmentHeight
			}
		}

		// Paint building parts (from bottom up)
		sectionCount := int8(numSections)
		sectionImageOffset := imageOffset
		partHeights := buildingObj.GetBuildingPartHeights()
		partAnims := buildingObj.GetBuildingPartAnimations()
		for _, part := range parts {
			if sectionCount == -1 {
				break
			}

			partAnim := partAnims[part]
			adjustedPart := int(part)

			// Compute animation frame offset
			frameMask := uint32(partAnim.NumFrames - 1)
			cl := partAnim.AnimationSpeed & 0x7F
			tickThing := ticks >> uint32(cl)
			if (partAnim.AnimationSpeed & (1 << 7)) != 0 {
				pos := WorldToTileSpace(session.GetUnkPosition())
				tickThing += uint32(pos.X*5 + pos.Y*3)
			}
			adjustedPart += int(frameMask & tickThing)

			sectionHeight := partHeights[adjustedPart]
			imageIdx := uint32(adjustedPart)*4 + buildingObj.Image + uint32(rotation)
			image := baseColour.WithIndex(imageIdx)

			// When the section is the currently-building one, apply noise mask if needed
			if sectionCount == 0 && !baseColour.IsBlended() {
				image = image.WithNoiseMask(uint8((sectionProgress+1)&0x7))
			}

			session.AddToPlotListAsChild(image, sectionImageOffset, bbOffset, bbSize)
			sectionImageOffset.Z += sectionHeight
			sectionCount--
		}

		// Scaffolding top/roof pieces after parts
		if totalSectionHeight != 0 && scaffSegType != 0xFF {
			scaffObj := ObjectManagerGetScaffoldingObject()
			segmentHeight := scaffObj.SegmentHeights[scaffSegType]
			var scaffImages ScaffoldingImagesRef
			if isMultiTile {
				scaffImages = GetScaffoldingImages(scaffSegType).Get2x2()
			} else {
				scaffImages = GetScaffoldingImages(scaffSegType).Get1x1()
			}

			baseScaffImageIdx := scaffObj.Image
			var baseScaffImage ImageId
			if element.IsGhost() {
				baseScaffImage = ApplyGhostToImage(baseScaffImageIdx)
			} else {
				baseScaffImage = NewImageId(baseScaffImageIdx, scaffoldingColour)
			}

			scaffImage := baseScaffImage.WithIndexOffset(scaffImages.Front)
			segmentImageOffset := imageOffset
			for remaining := int(totalSectionHeight); remaining > 0; remaining -= int(segmentHeight) {
				session.AddToPlotListAsChild(scaffImage, segmentImageOffset, bbOffset, bbSize)
				segmentImageOffset.Z += segmentHeight
			}
			// Roof piece
			scaffImage = baseScaffImage.WithIndexOffset(scaffImages.GetRoof(int(rotation)))
			session.AddToPlotListAsChild(scaffImage, segmentImageOffset, bbOffset, bbSize)
		}

		// Elevator animations (when there are no stacked sections)
		if totalSectionHeight == 0 {
			for animIdx := 0; animIdx < buildingObj.NumElevatorSequences; animIdx++ {
				sequence := buildingObj.GetElevatorHeightSequence(animIdx)
				tickThing := ScenarioManagerGetScenarioTicks() / 2
				pos := WorldToTileSpace(session.GetUnkPosition())
				tickThing += uint32(pos.X*8 + pos.Y*8)
				seqIdx := int(tickThing & uint32(len(sequence)-1))
				elevatorHeight := sequence[seqIdx]

				image := baseColour.WithIndex(buildingObj.Image + uint32(buildingObj.NumParts)*4 + uint32(animIdx)*4 + uint32(rotation))
				offset := imageOffset
				offset.Z += elevatorHeight
				session.AddToPlotListAsChild(image, offset, bbOffset, bbSize)
			}
		}
	}
}


// Paint building element
// Source: paintBuilding
func PaintBuilding(session *PaintSession, element *BuildingElement) {
	{
		// Determine ticks and construction state
		ticks := GetScenarioTicks()
		var numSections uint8 = 0xF0 // 0xF0 == all sections completed
		var sectionProgress uint8 = 0
		if !element.IsConstructed() {
			ticks = 0
			numSections = element.Age()
			sectionProgress = element.Unk5u()
		}

		variation := element.Variation()
		buildingObj := element.BuildingObject()
		parts := buildingObj.GetBuildingParts(variation)

		// Compute totalSectionHeight when building is under construction
		var totalSectionHeight uint32 = 0
		if numSections != 0xF0 {
			sectionCount := int(numSections)
			partHeights := buildingObj.GetBuildingPartHeights()
			for _, part := range parts {
				// assume part indexes are valid
				totalSectionHeight += uint32(partHeights[part])
				sectionCount--
				if sectionCount == -1 {
					if totalSectionHeight < 1 {
						totalSectionHeight = 1
					}
					break
				}
			}
		}

		scaffoldingColour := buildingObj.ScaffoldingColour
		scaffSegType := buildingObj.ScaffoldingSegmentType

		// Derive placement parameters from the element (these accessor names are reasonable stubs)
		imageOffset := element.ImageOffset()
		bbOffset := element.BBOffset()
		bbSize := element.BBSize()
		baseColour := element.BaseColour()
		rotation := int(element.Rotation())
		isMultiTile := element.IsMultiTile()

		// Draw scaffolding segments behind the building (stacked from bottom)
		if totalSectionHeight != 0 && scaffSegType != 0xFF {
			scaffObj := GetScaffoldingObject()
			segmentHeight := int(scaffObj.SegmentHeights[scaffSegType])
			var scaffImages ScaffoldingImageSet
			if isMultiTile {
				scaffImages = GetScaffoldingImages(scaffSegType).Get2x2()
			} else {
				scaffImages = GetScaffoldingImages(scaffSegType).Get1x1()
			}
			baseScaffImageIdx := scaffObj.Image
			var baseScaffImage ImageId
			if element.IsGhost() {
				baseScaffImage = ApplyGhostToImage(baseScaffImageIdx)
			} else {
				baseScaffImage = NewImageId(baseScaffImageIdx, scaffoldingColour)
			}
			scaffImage := baseScaffImage.WithIndexOffset(scaffImages.Back)
			segmentImageOffset := imageOffset
			remaining := int(totalSectionHeight)
			for remaining > 0 {
				session.AddToPlotListAsChild(scaffImage, segmentImageOffset, bbOffset, bbSize)
				remaining -= segmentHeight
				segmentImageOffset.Z += segmentHeight
			}
		}

		// Draw building parts (sections)
		sectionCount := int(numSections)
		sectionImageOffset := imageOffset
		partHeights := buildingObj.GetBuildingPartHeights()
		partAnimations := buildingObj.GetBuildingPartAnimations()
		for _, part := range parts {
			if sectionCount == -1 {
				break
			}
			partAnimation := partAnimations[part]
			adjustedPart := part

			// Animation frame selection
			frameMask := uint32(partAnimation.NumFrames - 1)
			cl := uint32(partAnimation.AnimationSpeed & 0x7F)
			tickThing := ticks >> cl
			if (partAnimation.AnimationSpeed & (1 << 7)) != 0 {
				pos := ToTileSpace(session.GetUnkPosition())
				tickThing += uint32(pos.X*5 + pos.Y*3)
			}
			adjustedPart += int(frameMask & tickThing)

			sectionHeight := partHeights[adjustedPart]
			imageIdx := adjustedPart*4 + buildingObj.Image + rotation
			image := baseColour.WithIndex(imageIdx)
			if sectionCount == 0 && !baseColour.IsBlended() {
				// apply noise mask for the last (incomplete) section
				image = image.WithNoiseMask((sectionProgress + 1) & 0x7)
			}
			session.AddToPlotListAsChild(image, sectionImageOffset, bbOffset, bbSize)
			sectionImageOffset.Z += sectionHeight
			sectionCount--
		}

		// Draw scaffolding front and roof if applicable
		if totalSectionHeight != 0 && scaffSegType != 0xFF {
			scaffObj := GetScaffoldingObject()
			segmentHeight := int(scaffObj.SegmentHeights[scaffSegType])
			var scaffImages ScaffoldingImageSet
			if isMultiTile {
				scaffImages = GetScaffoldingImages(scaffSegType).Get2x2()
			} else {
				scaffImages = GetScaffoldingImages(scaffSegType).Get1x1()
			}
			baseScaffImageIdx := scaffObj.Image
			var baseScaffImage ImageId
			if element.IsGhost() {
				baseScaffImage = ApplyGhostToImage(baseScaffImageIdx)
			} else {
				baseScaffImage = NewImageId(baseScaffImageIdx, scaffoldingColour)
			}
			scaffImage := baseScaffImage.WithIndexOffset(scaffImages.Front)
			segmentImageOffset := imageOffset
			remaining := int(totalSectionHeight)
			for remaining > 0 {
				session.AddToPlotListAsChild(scaffImage, segmentImageOffset, bbOffset, bbSize)
				remaining -= segmentHeight
				segmentImageOffset.Z += segmentHeight
			}
			// add roof piece
			scaffImage = baseScaffImage.WithIndexOffset(scaffImages.GetRoof(rotation))
			session.AddToPlotListAsChild(scaffImage, segmentImageOffset, bbOffset, bbSize)
		}

		// If there are no stacked sections, draw elevator sequences (animated vertical offsets)
		if totalSectionHeight == 0 {
			for animIdx := 0; animIdx < buildingObj.NumElevatorSequences; animIdx++ {
				sequence := buildingObj.GetElevatorHeightSequence(animIdx)
				tickThing := GetScenarioTicks() / 2
				pos := ToTileSpace(session.GetUnkPosition())
				tickThing += uint32(pos.X*8 + pos.Y*8)
				// sequence size is a power of two; use bitmask for wrap-around
				seqIdx := int(tickThing) & (len(sequence) - 1)
				elevatorHeight := sequence[seqIdx]

				image := baseColour.WithIndex(buildingObj.Image + buildingObj.NumParts*4 + animIdx*4 + rotation)
				offset := imageOffset
				offset.Z += elevatorHeight
				session.AddToPlotListAsChild(image, offset, bbOffset, bbSize)
			}
		}
	}
}
