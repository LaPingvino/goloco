package paint

// Auto-generated by batch_ai_impl using opencode + GPT-5-mini
// Original: Paint/PaintSurface.cpp

// Paint terrain surface with grass/dirt/water textures and slopes
// Source: Paint::paintSurface
func PaintSurface(session *PaintSession, elSurface *World.SurfaceElement) {
	{
		// nil check
		if elSurface == nil || session == nil {
			return
		}

		// rotate a 4-bit value left by r (mod 4)
		rotl4bit := func(v, r uint8) uint8 {
			r = r & 3
			return ((v << r) | (v >> (4 - r))) & 0xF
		}

		// replicate C++ getRotatedSlope: rotate low 4 bits and preserve bit 0x10
		getRotatedSlope := func(slope, rotation uint8) uint8 {
			return rotl4bit(slope&0xF, rotation) | (slope & 0x10)
		}

		// compute display slope from element fields
		displaySlope := getRotatedSlope(elSurface.Slope, elSurface.Rotation)

		// paint main surface image (follows logic from C++ paintMainSurface)
		imageIndex := uint32(elSurface.ImageIndex)
		imageId := ImageId(imageIndex)
		viewFlags := session.getViewFlags()
		// if underground or special flag is set, request translucency
		if (viewFlags&(UiViewportFlagsUndergroundView|UiViewportFlagsFlag7)) != UiViewportFlagsNone {
			imageId = imageId.withTranslucency(ExtColourUnk30)
		}

		baseHeight := int16(elSurface.BaseHeight)
		offsetUnk := WorldPos3{X: 0, Y: 0, Z: baseHeight}
		bbSizeUnk := WorldPos3{X: 32, Y: 32, Z: -1}
		session.addToPlotListAsParent(imageId, offsetUnk, bbSizeUnk)

		// If there are slope corner indicators, attach selection boxes for each corner
		// (mirrors paintSurfaceCornerSelection usage in C++)
		if displaySlope != 0 {
			for corner := uint8(0); corner < 4; corner++ {
				if (displaySlope & (1 << corner)) != 0 {
					colour := kCornerColours[corner]
					selectionImage := ImageId(kCornerSelectionBoxFromSlope[displaySlope], colour)
					// attach selection relative to previous image (0,0 offset)
					session.attachToPrevious(selectionImage, WorldPos{X: 0, Y: 0})
				}
			}
		}

		// Additional slope/water/snow handling would go here in a full port.
	}
}
