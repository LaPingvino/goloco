// Load S5 save/scenario file
// Source: S5::load
func LoadS5(path string) error {
	{
		// Local stub for SaveFlags to mirror C++ bitflags used in the original code.
		type SaveFlags uint32
		const (
			saveFlagNone       SaveFlags = 0
			saveFlagIsAutosave SaveFlags = 1 << iota
			saveFlagNoWindowClose
			saveFlagRaw
			saveFlagDump
		)

		// Start with default flags (none). Concrete flag value resolution can be added later.
		var flags SaveFlags = saveFlagNone

		// Show progress bar for non-autosave operations.
		if (flags & saveFlagIsAutosave) == saveFlagNone {
			ProgressBarBegin("please_wait")
			ProgressBarSetProgress(20)
		}

		// Close construction windows unless explicitly suppressed.
		if (flags&saveFlagNoWindowClose) == saveFlagNone &&
			(flags&saveFlagRaw) == saveFlagNone &&
			(flags&saveFlagDump) == saveFlagNone {
			WindowManagerCloseConstructionWindows()
		}

		// Perform various pre-save maintenance when not writing raw data.
		if (flags & saveFlagRaw) == saveFlagNone {
			TileManagerReorganise()
			EntityManagerResetSpatialIndex()
			EntityManagerZeroUnused()
			StationManagerZeroUnused()
			VehiclesOrderManagerZeroUnusedOrderTable()
		}

		if (flags & saveFlagIsAutosave) == saveFlagNone {
			ProgressBarSetProgress(40)
		}

		var saveResult bool

		// Collect required object headers and optionally build a packed list.
		requiredObjects := ObjectManagerGetHeaders()
		var packedObjects []ObjectHeader
		if shouldPackObjects(flags) {
			for _, header := range requiredObjects {
				if !header.IsEmpty() && !header.IsVanilla() {
					packedObjects = append(packedObjects, header)
				}
			}
		}

		// Prepare game state (may return an error).
		file, err := prepareGameState(flags, requiredObjects, packedObjects)
		if err != nil {
			if (flags & saveFlagIsAutosave) == saveFlagNone {
				ProgressBarEnd()
			}
			return err
		}

		// Export the prepared game state; handle errors idiomatically.
		saveResult, err = exportGameState(path, file, packedObjects)
		if err != nil {
			if (flags & saveFlagIsAutosave) == saveFlagNone {
				ProgressBarEnd()
			}
			return err
		}

		if (flags & saveFlagIsAutosave) == saveFlagNone {
			ProgressBarSetProgress(230)
		}

		// Reload objects unless raw/dump mode was used.
		if (flags&saveFlagRaw) == saveFlagNone && (flags&saveFlagDump) == saveFlagNone {
			ObjectManagerReloadAll()
		}

		if (flags & saveFlagIsAutosave) == saveFlagNone {
			ProgressBarEnd()
		}

		// On successful save, refresh UI and scene state.
		if saveResult {
			GfxInvalidateScreen()
			if (flags & saveFlagRaw) == saveFlagNone {
				SceneManagerResetSceneAge()
			}
		}

		return nil
	}
}


// Save game to S5 file
// Source: S5::save
func SaveS5(path string) error {
	// Create or truncate the destination file.
	f, err := os.Create(path)
	if err != nil {
		return fmt.Errorf("create save file %q: %w", path, err)
	}
	defer func() { _ = f.Close() }()

	// Local header representation (kept minimal and portable).
	// Fields chosen to mirror the original S5 header essentials.
	type s5Header struct {
		Type             uint8  // S5 type (saved game / landscape / scenario)
		NumPackedObjects uint16 // number of packed resource objects
		Version          uint16 // file format version
		Magic            uint32 // magic number for identification
		Flags            uint16 // header flags
	}

	// Prepare a conservative default header. Callers or future code can override.
	hdr := s5Header{
		Type:             1,       // 1 -> savedGame (placeholder)
		NumPackedObjects: 0,       // no packed objects in this basic implementation
		Version:          0x0014,  // example current version
		Magic:            0x534F4C4F, // 'SOLO' as example magic (placeholder)
		Flags:            0,
	}

	// Write header in little-endian order (matches typical C++ on x86).
	if err := binary.Write(f, binary.LittleEndian, hdr); err != nil {
		return fmt.Errorf("write header: %w", err)
	}

	// Prepare minimal save details. The original C++ writes structured binary data
	// (company names, owner, date, performance, scenario preview image, etc).
	// Here we write a compact JSON block as a placeholder so the file contains
	// readable, extensible metadata. This keeps the function simple and safe.
	saveDetails := map[string]interface{}{
		"company":          "",
		"owner":            "",
		"date":             0,
		"performanceIndex": 0,
		"challengeProgress": 0,
		"challengeFlags":   0,
		"scenario":         "",
		"image":            []byte{}, // placeholder for preview image bytes
	}

	// Encode details to the file. Using JSON is a pragmatic stand-in for the full
	// binary serialization done by the original implementation.
	enc := json.NewEncoder(f)
	if err := enc.Encode(saveDetails); err != nil {
		return fmt.Errorf("write save details: %w", err)
	}

	// Flush file to storage.
	if err := f.Sync(); err != nil {
		return fmt.Errorf("sync save file: %w", err)
	}

	return nil
}


// Load S5 save/scenario file
// Source: S5::load
func LoadS5(path string) error {
	{
		// Open destination file for writing the S5 data.
		outFile, err := os.Create(path)
		if err != nil {
			return err
		}
		defer outFile.Close()

		// Default flags (expected to be provided/filled elsewhere).
		var flags SaveFlags

		// Show progress when this is not an autosave.
		if flags&SaveFlagIsAutosave == SaveFlagNone {
			Ui.ProgressBar.Begin(StringIdPleaseWait)
			Ui.ProgressBar.SetProgress(20)
		}

		// Close construction windows unless certain flags are set.
		if flags&SaveFlagNoWindowClose == SaveFlagNone &&
			flags&SaveFlagRaw == SaveFlagNone &&
			flags&SaveFlagDump == SaveFlagNone {
			WindowManager.CloseConstructionWindows()
		}

		// Prepare world state before exporting when not in raw mode.
		if flags&SaveFlagRaw == SaveFlagNone {
			TileManager.Reorganise()
			EntityManager.ResetSpatialIndex()
			EntityManager.ZeroUnused()
			StationManager.ZeroUnused()
			Vehicles.OrderManager.ZeroUnusedOrderTable()
		}

		if flags&SaveFlagIsAutosave == SaveFlagNone {
			Ui.ProgressBar.SetProgress(40)
		}

		// Build object lists and prepare game state.
		var saveResult bool
		{
			requiredObjects := ObjectManager.GetHeaders()
			var packedObjects []ObjectHeader
			if shouldPackObjects(flags) {
				for _, hdr := range requiredObjects {
					// Skip empty or vanilla objects when packing.
					if !hdr.IsEmpty() && !hdr.IsVanilla() {
						packedObjects = append(packedObjects, hdr)
					}
				}
			}

			// Prepare in-memory representation of the game state.
			gameFile, err := prepareGameState(flags, requiredObjects, packedObjects)
			if err != nil {
				// If preparing the state failed, ensure progress UI is ended if needed and return error.
				if flags&SaveFlagIsAutosave == SaveFlagNone {
					Ui.ProgressBar.End()
				}
				return err
			}

			// Export the prepared state to the opened file.
			saveResult, err = exportGameState(outFile, gameFile, packedObjects)
			if err != nil {
				if flags&SaveFlagIsAutosave == SaveFlagNone {
					Ui.ProgressBar.End()
				}
				return err
			}
		}

		if flags&SaveFlagIsAutosave == SaveFlagNone {
			Ui.ProgressBar.SetProgress(230)
		}

		// Reload objects unless in raw or dump mode.
		if flags&SaveFlagRaw == SaveFlagNone && flags&SaveFlagDump == SaveFlagNone {
			ObjectManager.ReloadAll()
		}

		if flags&SaveFlagIsAutosave == SaveFlagNone {
			Ui.ProgressBar.End()
		}

		// On successful save, update graphics and scene state.
		if saveResult {
			Gfx.InvalidateScreen()
			if flags&SaveFlagRaw == SaveFlagNone {
				SceneManager.ResetSceneAge()
			}
		}

		return nil
	}
}


// Save game to S5 file
// Source: S5::save
func SaveS5(path string) error {
	{
		// Constants used in the S5 header (placeholders - real values to be provided elsewhere)
		const (
			kMagicNumber   uint32 = 0x53535000 // 'SPS\0' placeholder magic
			kCurrentVersion uint16 = 1
		)

		// Minimal header layout written in little-endian:
		// magic (uint32), version (uint16), type (uint8), numPackedObjects (uint16), flags (uint8)
		var (
			s5Type           uint8  = 1   // 1 == savedGame (placeholder)
			numPackedObjects uint16 = 0   // no packed objects by default
			headerFlags      uint8  = 0   // placeholder flags
		)

		// Create or overwrite the file
		f, err := os.Create(path)
		if err != nil {
			return err
		}
		// Ensure file is closed on all return paths
		defer func() {
			_ = f.Close()
		}()

		buf := &bytes.Buffer{}

		// Write header fields in little-endian order
		if err := binary.Write(buf, binary.LittleEndian, kMagicNumber); err != nil {
			return err
		}
		if err := binary.Write(buf, binary.LittleEndian, kCurrentVersion); err != nil {
			return err
		}
		if err := binary.Write(buf, binary.LittleEndian, s5Type); err != nil {
			return err
		}
		if err := binary.Write(buf, binary.LittleEndian, numPackedObjects); err != nil {
			return err
		}
		if err := binary.Write(buf, binary.LittleEndian, headerFlags); err != nil {
			return err
		}

		// Minimal SaveDetails stub:
		// We'll write fixed-length strings for company/owner/scenario (length-prefixed)
		// followed by a few numeric fields and a preview image blob length + data.
		// Real project will replace these with real structured data.
		writeString := func(s string) error {
			// write length (uint16) then bytes
			b := []byte(s)
			if len(b) > 0xFFFF {
				return fmt.Errorf("string too long")
			}
			if err := binary.Write(buf, binary.LittleEndian, uint16(len(b))); err != nil {
				return err
			}
			_, err := buf.Write(b)
			return err
		}

		// Use placeholder/empty values for save details
		if err := writeString("Unknown Company"); err != nil {
			return err
		}
		if err := writeString("Unknown Owner"); err != nil {
			return err
		}
		// date (uint32)
		if err := binary.Write(buf, binary.LittleEndian, uint32(0)); err != nil {
			return err
		}
		// performanceIndex (uint8), challengeProgress (uint8), challengeFlags (uint8)
		if err := binary.Write(buf, binary.LittleEndian, uint8(0)); err != nil {
			return err
		}
		if err := binary.Write(buf, binary.LittleEndian, uint8(0)); err != nil {
			return err
		}
		if err := binary.Write(buf, binary.LittleEndian, uint8(0)); err != nil {
			return err
		}
		// scenario name
		if err := writeString(""); err != nil {
			return err
		}

		// preview image: write length uint32 then zero bytes (placeholder)
		var previewImage []byte
		if err := binary.Write(buf, binary.LittleEndian, uint32(len(previewImage))); err != nil {
			return err
		}
		if len(previewImage) > 0 {
			if _, err := buf.Write(previewImage); err != nil {
				return err
			}
		}

		// If there were packed objects, they'd follow here. We write none.

		// Flush buffer to disk
		if _, err := f.Write(buf.Bytes()); err != nil {
			return err
		}
		// Ensure data is flushed to storage
		if err := f.Sync(); err != nil {
			return err
		}

		return nil
	}
}
