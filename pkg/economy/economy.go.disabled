// Monthly economy updates
// Source: Economy::updateMonthly
func UpdateEconomyMonthly() {
	{
		// Get the currency multiplication factors slice (expected length 32).
		factors := currencyMultiplicationFactors()

		// Determine safe loop bound (defensive: prefer the smallest length).
		n := 32
		if len(factors) < n {
			n = len(factors)
		}
		if len(kInflationFactors) < n {
			n = len(kInflationFactors)
		}

		// Update each factor by applying the inflation multiplier.
		// Use 64-bit intermediate to avoid overflow, then shift right 12 bits.
		for i := 0; i < n; i++ {
			inc := (uint64(kInflationFactors[i]) * uint64(factors[i])) >> 12
			factors[i] = uint32(uint64(factors[i]) + inc)
		}

		// Rebuild derived tables and refresh affected UI windows.
