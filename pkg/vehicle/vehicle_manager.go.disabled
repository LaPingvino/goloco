// Update all vehicles
// Source: VehicleManager::update
func UpdateVehicles() {
	// Only run updates when the tile manager is loaded and we're not in editor mode
	if !gameHasFlags(tileManagerLoaded) || sceneManagerIsEditorMode() {
		return
	}

	for _, v := range vehicleList() {
		if v == nil {
			continue
		}

		// updateVehicle may return an error (stubbed). Handle errors via a helper so
		// callers can decide how to surface or log them.
		if err := v.updateVehicle(); err != nil {
			handleVehicleError(v, err)
		}
	}
}


// Update all vehicles
// Source: VehicleManager::update
func UpdateVehicles() {
	{
		// Only update vehicles when the tile manager is loaded and not in editor mode.
		if !GameHasFlags(TileManagerLoaded) || SceneManagerIsEditorMode() {
			return
		}

		// Collect errors from vehicle updates to handle them after the loop.
		var errs []error
		for _, v := range VehicleList() {
			if v == nil {
				continue
			}
			if err := v.UpdateVehicle(); err != nil {
				errs = append(errs, err)
			}
		}

		// Handle any errors encountered during updates.
		for _, err := range errs {
			handleVehicleError(err)
		}
	}
}


// Place vehicle on track/road
// Source: placeDownVehicle
func PlaceDownVehicle(head *VehicleHead, x coord_t, y coord_t, baseZ uint8, trackDir TrackAndDirection) PlaceDownResult {
	{
		// Default initial sub-position (original C++ accepted it as a parameter).
		initialSubPosition := 0

		// Position in world coordinates
		pos := World.Pos3{x, y, baseZ * World.kSmallZStep}

		// If already placed
		if head.tileX != -1 {
			return PlaceDownResultOkay
		}

		subPosition := 0
		reversePos := pos
		reverseTad := trackDir

		// Prepare reversed placement depending on transport mode
		if head.mode != TransportModeRoad {
			// Check immediate occupancy/flags at the forward position
			if Vehicles.sub_4A2A58(pos, trackDir.track, head.owner, head.trackType)&(1<<0) != 0 {
				return PlaceDownResultUnk1
			}
			if Vehicles.isBlockOccupied(pos, trackDir.track, head.owner, head.trackType) {
				return PlaceDownResultUnk1
			}

			// Compute sub-position mirrored from initial
			subPosLen := len(World.TrackData.getTrackSubPositon(trackDir.track._data))
			subPosition = subPosLen - 1 - initialSubPosition

			// Adjust reverse position using track size and rotation offsets
			trackSize := World.TrackData.getUnkTrack(trackDir.track._data)
			reversePos = reversePos.Add(trackSize.pos)
			if trackSize.rotationEnd < 12 {
				reversePos = reversePos.Sub(World.Pos3{World.kRotationOffset[trackSize.rotationEnd], 0, 0})
			}
			reverseTad.track.setReversed(!trackDir.track.isReversed())
		} else {
			// Road mode: similar handling but with road-specific data and lane flags
			subPosLen := len(World.TrackData.getRoadSubPositon(trackDir.road._data))
			subPosition = subPosLen - 1 - initialSubPosition

			roadSize := World.TrackData.getUnkRoad(trackDir.road.basicRad())
			reversePos = reversePos.Add(roadSize.pos)
			if roadSize.rotationEnd < 12 {
				reversePos = reversePos.Sub(World.Pos3{World.kRotationOffset[roadSize.rotationEnd], 0, 0})
			}
			reverseTad.road.setReversed(!trackDir.road.isReversed())

			// Toggle lane/overtake bits in the reversed road _data to mirror original logic
			reverseTad.road._data ^= (1 << 7)
			if reverseTad.road.isChangingLane() {
				reverseTad.road._data ^= (1 << 7)
				if !reverseTad.road.isOvertaking() {
					reverseTad.road._data ^= (1 << 8)
				}
			}
		}

		// Reset and set routing for the reversed direction
		Vehicles.RoutingManager.resetRoutings(head.routingHandle)
		Vehicles.RoutingManager.setRouting(head.routingHandle, reverseTad.track._data)

		// Check occupancy for the reverse position as well
		if head.mode == TransportModeRoad {
			occ := Vehicles.getRoadOccupation(reversePos, reverseTad.road)
			if occ&(Vehicles.RoadOccupationFlagsIsLaneOccupied|Vehicles.RoadOccupationFlagsIsLevelCrossingClosed) != Vehicles.RoadOccupationFlagsNone {
				return PlaceDownResultUnk1
			}
		} else {
			if Vehicles.sub_4A2A58(reversePos, reverseTad.track, head.owner, head.trackType)&(1<<0) != 0 {
				return PlaceDownResultUnk1
			}
			if Vehicles.isBlockOccupied(reversePos, reverseTad.track, head.owner, head.trackType) {
				return PlaceDownResultUnk1
			}
		}

		// Build a temporary vehicle instance and place components at reversed sub-position
		train := Vehicles.NewVehicleFromHead(head)
		train.applyToComponents(func(component interface{}) {
			// set routing and tile/subposition data on each component
			component.setRoutingHandle(head.routingHandle)
			component.setTileX(reversePos.x)
			component.setTileY(reversePos.y)
			component.setTileBaseZ(reversePos.z / World.kSmallZStep)
			component.setSubPosition(subPosition)
			component.setTrackAndDirection(reverseTad)
			component.setRemainingDistance(0)
			// positions the sprite and move component to correct sub-position
			moveComponentToSubPosition(component)
		})

		// Zero temporary variables used by rendering/placement for head and first car
		train.head.setVar3C(0)
		train.veh1.setVar3C(0)

		// Adjust vehicle object lengths and attempt to position on the track
		Vehicles.applyVehicleObjectLength(train)
		oldVar52 := head.var_52
		head.var_52 = 1
		failure := Vehicles.positionVehicleOnTrack(head, true)
		head.var_52 = oldVar52

		if failure {
			// On failure, lift vehicle back up and report failure
			head.liftUpVehicle()
			return PlaceDownResultUnk0
		}

		// Finalize placement: run final setup, mark stopped and set flags
		head.var_52 = 1
		head.sub_4ADB47(true)
		head.var_52 = oldVar52
		head.status = VehiclesStatusStopped
		train.veh1.var_48 |= VehiclesFlags48Flag2

		return PlaceDownResultOkay
	}
}


// Place vehicle on track/road
// Source: placeDownVehicle
func PlaceDownVehicle(head *VehicleHead, x coord_t, y coord_t, baseZ uint8, trackDir TrackAndDirection) PlaceDownResult {
	{
		// Build position from coordinates and baseZ (World.kSmallZStep)
		pos := WorldPos3{X: int(x), Y: int(y), Z: int(baseZ) * WorldKSmallZStep}

		// If already placed, nothing to do
		if head.TileX != -1 {
			return PlaceDownResultOkay
		}

		// initialSubPosition parameter existed in C++ but not in the Go signature;
		// default to 0 to preserve similar behaviour.
		initialSubPosition := 0

		subPosition := 0
		reversePos := pos
		reverseTad := trackDir

		// Non-road handling
		if head.Mode != TransportModeRoad {
			// If route/flags prevent placement at the forward pos, fail
			if VehiclesSub4A2A58(pos, trackDir.Track, head.Owner, head.TrackType)&(1<<0) != 0 {
				return PlaceDownResultUnk1
			}

			if VehiclesIsBlockOccupied(pos, trackDir.Track, head.Owner, head.TrackType) {
				return PlaceDownResultUnk1
			}

			subPositionLength := len(WorldTrackDataGetTrackSubPosition(trackDir.Track.Data))
			subPosition = subPositionLength - 1 - initialSubPosition

			trackSize := WorldTrackDataGetUnkTrack(trackDir.Track.Data)
			reversePos = reversePos.Add(trackSize.Pos)
			if trackSize.RotationEnd < 12 {
				// adjust for rotation offset
				reversePos = reversePos.Sub(WorldPos3{X: WorldKRotationOffset[trackSize.RotationEnd], Y: 0, Z: 0})
			}
			reverseTad.Track.SetReversed(!trackDir.Track.IsReversed())
		} else {
			// Road handling
			subPositionLength := len(WorldTrackDataGetRoadSubPosition(trackDir.Road.Data))
			subPosition = subPositionLength - 1 - initialSubPosition

			roadSize := WorldTrackDataGetUnkRoad(trackDir.Road.BasicRad)
			reversePos = reversePos.Add(roadSize.Pos)
			if roadSize.RotationEnd < 12 {
				reversePos = reversePos.Sub(WorldPos3{X: WorldKRotationOffset[roadSize.RotationEnd], Y: 0, Z: 0})
			}
			reverseTad.Road.SetReversed(!trackDir.Road.IsReversed())
			// flip lane-change bit as in original
			reverseTad.Road.Data ^= (1 << 7)
			if reverseTad.Road.IsChangingLane() {
				reverseTad.Road.Data ^= (1 << 7)
				if !reverseTad.Road.IsOvertaking() {
					reverseTad.Road.Data ^= (1 << 8)
				}
			}
		}

		// Reset/set routing for the head
		RoutingManagerResetRoutings(head.RoutingHandle)
		RoutingManagerSetRouting(head.RoutingHandle, reverseTad.Track.Data)

		// Check occupation at reverse position depending on mode
		if head.Mode == TransportModeRoad {
			occ := VehiclesGetRoadOccupation(reversePos, reverseTad.Road)
			mask := RoadOccupationFlagIsLaneOccupied | RoadOccupationFlagIsLevelCrossingClosed
			if occ&mask != RoadOccupationFlagNone {
				return PlaceDownResultUnk1
			}
		} else {
			if VehiclesSub4A2A58(reversePos, reverseTad.Track, head.Owner, head.TrackType)&(1<<0) != 0 {
				return PlaceDownResultUnk1
			}
			if VehiclesIsBlockOccupied(reversePos, reverseTad.Track, head.Owner, head.TrackType) {
				return PlaceDownResultUnk1
			}
		}

		// Create a temporary Vehicle instance from the head and place components at reversePos/subPosition
		train := NewVehicleFromHead(head)

		train.ApplyToComponents(func(component *VehicleComponent) {
			component.RoutingHandle = head.RoutingHandle
			component.TileX = reversePos.X
			component.TileY = reversePos.Y
			component.TileBaseZ = reversePos.Z / WorldKSmallZStep
			component.SubPosition = subPosition
			component.TrackAndDirection = reverseTad
			component.RemainingDistance = 0
			moveComponentToSubPosition(component)
		})

		// Clear transient vars used during placement
		if train.Head != nil {
			train.Head.Var3C = 0
		}
		if train.Veh1 != nil {
			train.Veh1.Var3C = 0
		}

		ApplyVehicleObjectLength(train)

		// Temporarily set var_52 on head while positioning
		oldVar52 := head.Var52
		head.Var52 = 1
		failure := PositionVehicleOnTrack(head, true)
		head.Var52 = oldVar52

		if failure {
			head.LiftUpVehicle()
			return PlaceDownResultUnk0
		}

		// Finalize placement state
		head.Var52 = 1
		head.Sub4ADB47(true)
		head.Var52 = oldVar52
		head.Status = VehicleStatusStopped
		if train.Veh1 != nil {
			train.Veh1.Var48 |= VehicleFlag48Flag2
		}

		return PlaceDownResultOkay
	}
}
