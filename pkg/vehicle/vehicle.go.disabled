}


// Update vehicle movement and logic
// Source: Vehicle::update
func (v *Vehicle) Update() {
	train := v.train
	if train == nil {
		return
	}

	if v.getSubType() == VehicleEntityTypeVehicle2 {
		// If this vehicle is the special "vehicle_2" subtype, mark the front bogie of the first car.
		if len(train.cars) > 0 {
			firstCar := train.cars[0]
			if len(firstCar) > 0 && firstCar[0].front != nil {
				bogie := firstCar[0].front
				bogie.var5A |= uint32(1) << 31
				bogie.tileX = 0
				bogie.tileY = 0
				bogie.tileBaseZ = 0
			}
		}
	} else if v.getSubType() == VehicleEntityTypeBogie {
		// If this entity already is a bogie, mark itself.
		if bogie := v.asVehicleBogie(); bogie != nil {
			bogie.var5A |= uint32(1) << 31
			bogie.tileX = 0
			bogie.tileY = 0
			bogie.tileBaseZ = 0
		}
	} else {
		// For other subtypes, find the component whose body is this vehicle and use its back bogie.
		var explodeBogie *VehicleBogie
	found:
		for _, car := range train.cars {
			for _, comp := range car {
				explodeBogie = comp.back
				if comp.body == v {
					break found
				}
			}
		}

		if explodeBogie != nil {
			explodeBogie.var5A |= uint32(1) << 31
			explodeBogie.tileX = 0
			explodeBogie.tileY = 0
			explodeBogie.tileBaseZ = 0
		}
	}
}
