			// other subtypes: find the component whose body is this vehicle and use its back bogie
			var explodeBogie *VehicleBogie
			for _, car := range train.Cars {
				for _, carComponent := range car {
					explodeBogie = carComponent.Back
					if carComponent.Body == v {
