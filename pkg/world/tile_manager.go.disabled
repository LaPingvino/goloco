// Get tile by 2D position from map array
// Source: TileManager::get
func GetTile(pos World.Pos2) *Tile {
	{
		x := int(pos.X)
		y := int(pos.Y)

		// basic bounds check for negative coordinates
		if x < 0 || y < 0 {
			return nil
		}

		// If map dimensions are available, validate against them.
		// mapColumns = number of columns (width), mapPitch = stride (columns per row)
		if mapColumns > 0 && mapPitch > 0 {
			if x >= mapColumns || y >= mapPitch {
				return nil
			}
		}

		// Compute linear index into the tiles slice (row-major).
		// idx = y*stride + x
		idx := y*mapPitch + x

		// Final safety check against the tiles slice bounds.
		if idx < 0 || idx >= len(tiles) {
			return nil
		}

		return tiles[idx]
	}
}


// Get land and water height at tile position
// Source: TileManager::getHeight
func GetTileHeight(pos World.Pos2) TileHeight {
	{
		// Default height (land 16, water 0)
		height := TileHeight{LandHeight: 16, WaterHeight: 0}

		// Off the map
		if uint(pos.X) >= (World.KMapWidth-1) || uint(pos.Y) >= (World.KMapHeight-1) {
			return height
		}

		tile := TileManagerGet(pos)
		if tile == nil {
			return height
		}

		// Get surface element
		surfaceEl := tile.Surface()
		if surfaceEl == nil {
			return height
		}

		height.WaterHeight = surfaceEl.WaterHeight()
		height.LandHeight = surfaceEl.BaseHeight()

		slope := surfaceEl.SlopeCorners()

		// Sub-tile coords (0..31)
		xl := int(pos.X) & 0x1f
		yl := int(pos.Y) & 0x1f

		// Apply slope adjustments
		switch slope {
		case SurfaceSlopeFlat:
			// flat: nothing to do

		case SurfaceSlopeCornerUpNorth,
			SurfaceSlopeCornerUpEast,
			SurfaceSlopeCornerUpSouth,
			SurfaceSlopeCornerUpWest:
			height.LandHeight += getOneCornerUpLandHeight(xl, yl, slope)

		case SurfaceSlopeSideUpNortheast,
			SurfaceSlopeSideUpSoutheast,
			SurfaceSlopeSideUpNorthwest,
			SurfaceSlopeSideUpSouthwest:
			height.LandHeight += getOneSideUpLandHeight(xl, yl, slope)

		case SurfaceSlopeCornerDownNorth,
			SurfaceSlopeCornerDownEast,
			SurfaceSlopeCornerDownSouth,
			SurfaceSlopeCornerDownWest:
			// surfaceEl.IsSlopeDoubleHeight indicates extra-height slopes
			height.LandHeight += getOneCornerDownLandHeight(xl, yl, slope, surfaceEl.IsSlopeDoubleHeight())

		case SurfaceSlopeValleyNorthSouth,
			SurfaceSlopeValleyWestEast:
			height.LandHeight += getValleyLandHeight(xl, yl, slope)
		}

		return height
	}
}


// Update all tiles (animations, etc)
// Source: TileManager::update
func UpdateTiles() {
	{
		// Get map dimensions; return early if invalid
		width, height := getMapSize()
		if width <= 0 || height <= 0 {
			return
		}

		// Update every tile (animations, fluids, effects, etc).
		// Continue on errors but report them via `reportError`.
		for y := 0; y < height; y++ {
			for x := 0; x < width; x++ {
				tile := getTile(x, y)
				if tile == nil {
					continue
				}
				if err := tile.Update(); err != nil {
					// Non-fatal: record or log the error for later inspection
					reportError(err)
				}
			}
		}

		// Advance any periodic maintenance (defrag, housekeeping).
		// These helpers are intentionally small/no-op stubs when not needed.
		if shouldAdvancePeriodicDefrag() {
			if err := advancePeriodicDefrag(); err != nil {
				reportError(err)
			}
		}

		// Finalize frame-level tile updates (flush animation state, swap buffers, etc).
		if err := finalizeTileUpdates(); err != nil {
			reportError(err)
		}
	}
}


// Remove tile element
// Source: TileManager::removeElement
func RemoveElement(element *TileElement) {
	{
		// Defensive nil check
		if element == nil {
			return
		}

		// If caller holds a special pointer to this element, and this element is last, clear it.
		if element == f00158 {
			if element.IsLast() {
				f00158 = nil
			}
		}

		if element.IsLast() {
			// If this is the last element in the tile, mark the previous as last and free this element.
			prev := element.Prev()
			if prev != nil {
				prev.SetLastFlag(true)
			}
			markElementAsFree(element)
			return
		}

		// Move each following element up one slot until we reach the last element.
		cur := element
		next := element.Next()

		for {
			// Copy the next element into the current slot.
			*cur = *next

			// If 'next' was the last element, advance cur to the last slot (post-increment behaviour in C++)
			// and break so we can free that last slot.
			if next.IsLast() {
				cur = cur.Next()
				break
			}

			// Advance both pointers.
			cur = cur.Next()
			next = next.Next()

			// Defensive check to avoid nil dereference in case of malformed lists.
			if cur == nil || next == nil {
				return
			}
		}

		// Mark the now-unused slot as free.
		markElementAsFree(cur)
	}
}


// Remove tile element
// Source: TileManager::removeElement
func RemoveElement(element *TileElement) {
	if element == nil {
		return
	}

	// If caller is holding the special pointer, invalidate it when removing the last element.
	if element == f00158 {
		if element.IsLast() {
			f00158 = nil
		}
	}

	if element.IsLast() {
		prev := element.Prev()
		if prev != nil {
			prev.SetLastFlag(true)
		}
		markElementAsFree(element)
	} else {
		// Shift following elements up one slot until we copy the last element.
		cur := element
		next := cur.Next()
		for {
			*cur = *next
			// If the element we just copied was the last, stop.
			if next.IsLast() {
				break
			}
			// Advance pointers to the next positions in the underlying array.
			cur = cur.Next()
			next = next.Next()
		}
		// The slot pointed to by `cur` is now free.
		markElementAsFree(cur)
	}
}


// Insert new tile element
// Source: TileManager::insertElement
func InsertElement(typ ElementType, pos Pos2, baseZ uint8, occupiedQuads uint8) *TileElement {
	{
		// Convert world position to tile coordinates (assumes `WorldTileSize` exists).
		tilePos := TilePos2{X: pos.X / WorldTileSize, Y: pos.Y / WorldTileSize}

		// Prepare destination slot for a new element; this also updates tile head.
		source, dest := insertElementPrepareDest(tilePos)
		if dest == nil {
			// Unable to allocate/prepare destination for element.
			return nil
		}

		// Initialize the new element in the prepared slot.
		element := dest
		element.Type = typ
		element.TilePos = tilePos
		element.BaseZ = baseZ
		element.OccupiedQuads = occupiedQuads

		// Insert at the head of the tile's element list.
		element.Next = source
		element.Prev = nil
		if source != nil {
			source.Prev = element
		}

		return element
	}
}
