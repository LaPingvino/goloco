// Get loaded object by handle
// Source: ObjectManager::get
func GetObject(handle LoadedObjectHandle) *Object {
	// handle value 0 = invalid
	if handle == 0 {
		return nil
	}

	// Assume handle packs type in high 8 bits and index in low 24 bits.
	h := uint32(handle)
	objType := ObjectType((h >> 24) & 0xFF)
	objIndex := int(h & 0x00FFFFFF)

	// Defensive checks
	if objIndex < 0 {
		return nil
	}

	// `objectRepository` is expected to map ObjectType -> slice of *Object
	if objs, ok := objectRepository[objType]; ok {
		if objIndex < len(objs) {
			return objs[objIndex]
		}
	}

	return nil
}


// Load all game objects
// Source: ObjectManager::loadAll
func LoadAllObjects(headers []ObjectHeader) LoadObjectsResult {
	{
		start := time.Now()
		var loaded int
		var errs []error

		// Iterate headers and try to construct, validate and load each object.
		for idx, hdr := range headers {
			// Create an object instance for this header (implementation provided elsewhere).
			obj, err := NewObjectFromHeader(hdr)
			if err != nil {
				errs = append(errs, fmt.Errorf("object %d: create: %w", idx, err))
				continue
			}

			// Validate before attempting to load.
			if err := obj.Validate(); err != nil {
				errs = append(errs, fmt.Errorf("object %d: validate: %w", idx, err))
				// Best-effort cleanup if object exposes Unload.
				_ = obj.Unload()
				continue
			}

			// Load object data (assumes header provides Data []byte).
			if err := obj.Load(hdr.Data); err != nil {
				errs = append(errs, fmt.Errorf("object %d: load: %w", idx, err))
				_ = obj.Unload()
				continue
			}

			loaded++
		}

		return LoadObjectsResult{
			Loaded:   loaded,
			Errors:   errs,
			Duration: time.Since(start),
		}
	}
}


// Load all game objects
// Source: ObjectManager::loadAll
func LoadAllObjects(headers []ObjectHeader) LoadObjectsResult {
	{
		// Result accumulator
		var result LoadObjectsResult
		loaded := 0

		// Helper closure that encapsulates the per-header load/validate/unload lifecycle.
		// We use a closure so the implementation reads clearly and keeps error handling local.
		loadOne := func(h ObjectHeader) error {
			// Create or obtain an object instance for this header.
			// Implementations should provide `NewObjectFromHeader` (or similar) that
			// constructs the right concrete object for the header's type.
			obj, err := NewObjectFromHeader(h)
			if err != nil {
				return err
			}

			// Load the object's data. The concrete object's `Load` method should accept
			// whatever information the header carries (for example raw bytes or a handle).
			if err := obj.Load(h); err != nil {
				// If load fails, ensure any partial state is cleaned up.
				_ = obj.Unload()
				return err
			}

			// Validate the loaded object. If validation fails, unload and return the error.
			if err := obj.Validate(); err != nil {
				_ = obj.Unload()
				return err
			}

			// Successfully loaded and validated — record it.
			result.Objects = append(result.Objects, obj)
			return nil
		}

		// Iterate all headers and attempt to load each object.
		for _, hdr := range headers {
			if err := loadOne(hdr); err != nil {
				// Collect errors but continue loading remaining objects.
				result.Errors = append(result.Errors, err)
				continue
			}
			loaded++
		}

		// Populate summary fields on the result.
		result.LoadedCount = loaded
		return result
	}
}
