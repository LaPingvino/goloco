// Join multiplayer game
// Source: Network::join
func JoinGame(host string, port uint16) error {
	if host == "" {
		return fmt.Errorf("host is required")
	}

	if port == 0 {
		port = kDefaultPort
	}

	// Build address and try a TCP dial with a short timeout.
	addr := net.JoinHostPort(host, strconv.Itoa(int(port)))
	conn, err := net.DialTimeout("tcp", addr, 5*time.Second)
	if err != nil {
		return fmt.Errorf("join %s: %w", addr, err)
	}

	// Wrap the raw connection in the project's NetworkClient type.
	// If initialization fails, ensure the connection is closed.
	nc, err := NewNetworkClient(conn)
	if err != nil {
		_ = conn.Close()
		return fmt.Errorf("initializing network client: %w", err)
	}

	// Set package-level state to reflect we are now a client.
	client = nc
	mode = ModeClient

	// Update scene/UI state to indicate we're in a networked client session.
	// These calls are intentionally best-effort; if the helpers are no-ops that's fine.
	addSceneFlags(SceneFlagNetworked)
	addSceneFlags(SceneFlagNetworkClient)
	invalidateScreen()

	return nil
}


// Host multiplayer game
// Source: Network::host
func HostGame(port uint16) error {
	// refuse to host if already in a networked mode
		if mode != networkModeNone {
			return fmt.Errorf("network already active")
		}

		// create the server and attempt to listen on the requested port
		srv := &NetworkServer{}

		// If a panic happens while starting the server, ensure we don't leave a dangling server reference.
		defer func() {
			if r := recover(); r != nil {
				server = nil
				panic(r)
			}
		}()

		if err := srv.Listen("", port); err != nil {
			// on error, don't keep the partially-initialized server
			return err
		}

		// commit the running server and update mode
		server = srv
		mode = networkModeServer

		// mark the scene as networked host and refresh the display
		SceneManagerAddSceneFlags(SceneManagerFlagNetworked)
		SceneManagerAddSceneFlags(SceneManagerFlagNetworkHost)
		GfxInvalidateScreen()

		return nil
}


// Join multiplayer game
// Source: Network::join
func JoinGame(host string, port uint16) error {
	// ensure we're not already in a network session
	if _mode != NetworkModeNone {
		return fmt.Errorf("already in network mode")
	}

	// create client and try to connect
	client := &NetworkClient{}
	if err := client.Connect(host, port); err != nil {
		// cleanup on failure
		client = nil
		return fmt.Errorf("failed to join server %s:%d: %w", host, port, err)
	}

	// store client and mark mode
	_client = client
	_mode = NetworkModeClient

	// mark the scene as networked and refresh the screen
	SceneManager.AddSceneFlags(SceneManagerFlagNetworked)
	Gfx.InvalidateScreen()

	return nil
}


// Host multiplayer game
// Source: Network::host
func HostGame(port uint16) error {
	{
		// Read command-line options for bind/port defaults
		opts := getCommandLineOptions()
		bind := opts.bind

		// Use provided port, otherwise prefer command-line port, then default
		usePort := port
		if usePort == 0 {
			if opts.port != 0 {
				usePort = opts.port
			} else {
				usePort = kDefaultPort
			}
		}

		// Create and start the server; propagate listen errors
		srv := &NetworkServer{}
		if err := srv.Listen(bind, usePort); err != nil {
			// ensure we don't keep a partially initialized server
			srv = nil
			return err
		}

		// Publish server and set mode
		_server = srv
		_mode = NetworkModeServer

		// Enable networked scene flags and refresh graphics
		SceneManager.addSceneFlags(SceneManager.Flags.networked)
		SceneManager.addSceneFlags(SceneManager.Flags.networkHost)
		Gfx.invalidateScreen()

		return nil
	}
}
