// Post new message to player
// Source: MessageManager::post
func PostMessage(typ MessageType, companyId CompanyId, subject uint16, item uint16) {
	{
		// Prepare new message
		newMessage := Message{
			CompanyID:    companyId,
			Type:         typ,
			Date:         getCurrentDay(),
			ItemSubjects: [3]uint16{subject, item, 0},
		}

		// helper: equality that ignores company id (matches C++ behaviour)
		equalIgnoringCompany := func(a, b Message) bool {
			if a.Type != b.Type {
				return false
			}
			if a.Date != b.Date {
				return false
			}
			if a.TimeActive != b.TimeActive {
				return false
			}
			for i := 0; i < 3; i++ {
				if a.ItemSubjects[i] != b.ItemSubjects[i] {
					return false
				}
			}
			return true
		}

		// Deduplicate if required
		desc := getMessageTypeDescriptor(typ)
		if desc.HasFlag(ShouldDedup) {
			messages := rawMessages()
			for i := 0; i < int(getNumMessages()); i++ {
				if equalIgnoringCompany(messages[i], newMessage) {
					// identical message already present
					return
				}
			}
		}

		// If at capacity, remove the oldest message according to rules
		if getNumMessages() >= LimitsMaxMessages {
			var oldestMessage MessageId = MessageIdNull
			oldest := -1
			messages := rawMessages()
			num := int(getNumMessages())
			for i := 0; i < num; i++ {
				m := messages[i]
				if m.TimeActive != 0 {
					age := int(getMessageTypeDescriptor(m.Type).Duration) + int(m.Date) - int(getCurrentDay())
					if age > oldest {
						oldest = age
						oldestMessage = MessageId(i)
					}
				}
			}
			// If none found in active set, search all messages
			if oldest == -1 {
				for i := 0; i < num; i++ {
					m := messages[i]
					age := int(getMessageTypeDescriptor(m.Type).Duration) + int(m.Date) - int(getCurrentDay())
					if age > oldest {
						oldest = age
						oldestMessage = MessageId(i)
					}
				}
			}
			if oldestMessage != MessageIdNull {
				remove(oldestMessage)
			}
		}

		// Match original behaviour: copy existing message-string buffer from the slot
		messages := rawMessages()
		num := int(getNumMessages())
		if num < len(messages) {
			// safe copy for both slice/array-like backing
			copy(newMessage.MessageString[:], messages[num].MessageString[:])
		}

		// Append new message
		messages[num] = newMessage
		msg := &messages[num]
		setNumMessages(uint16(num + 1))

		// Formatting buffer used to build the human-readable string
		var tempBuffer [512]byte

		// Populate human-readable message text based on type
		switch msg.Type {
		case MessageTypeCantWaitForFullLoad:
			// Example: include vehicle name, ordinal, station name and town
			args := FormatArguments{}
			head := EntityManagerGetVehicleHead(EntityId(msg.ItemSubjects[0]))
			if head == nil {
				break
			}
			args.Push(head.Name)
			args.Push(head.OrdinalNumber)
			station := StationManagerGet(StationId(msg.ItemSubjects[1]))
			args.Push(station.Name)
			args.Push(station.Town)
			StringManagerFormatString(tempBuffer[:], StringIdMessageNotAllowedToWaitForFullLoadAt, args)

		case MessageTypeIndustryClosingDown:
			args := FormatArguments{}
			industry := IndustryManagerGet(IndustryId(msg.ItemSubjects[0]))
			if industry == nil {
				break
			}
			args.Push(industry.Name)
			args.Push(industry.Town)
			industryObj := industry.GetObject()
			StringManagerFormatString(tempBuffer[:], industryObj.NameClosingDown, args)

		case MessageTypeVehicleSlipped:
			args := FormatArguments{}
			head := EntityManagerGetVehicleHead(EntityId(msg.ItemSubjects[0]))
			if head == nil {
				break
			}
			args.Push(head.Name)
			args.Push(head.OrdinalNumber)
			StringManagerFormatString(tempBuffer[:], StringIdMessageHasSlippedToAHaltOnIncline, args)

		// unk3..unk8: intentionally no-op
		case MessageTypeUnk3, MessageTypeUnk4, MessageTypeUnk5, MessageTypeUnk6, MessageTypeUnk7, MessageTypeUnk8:
			// no formatting

		case MessageTypeCargoNowAccepted:
			args := FormatArguments{}
			station := StationManagerGet(StationId(msg.ItemSubjects[0]))
			args.Push(station.Name)
			args.Push(station.Town)
			cargoObj := ObjectManagerGetCargoObject(msg.ItemSubjects[1])
			args.Push(cargoObj.Name)
			StringManagerFormatString(tempBuffer[:], StringIdMessageNowAccepts, args)

		case MessageTypeCargoNoLongerAccepted:
			args := FormatArguments{}
			station := StationManagerGet(StationId(msg.ItemSubjects[0]))
			args.Push(station.Name)
			args.Push(station.Town)
			cargoObj := ObjectManagerGetCargoObject(msg.ItemSubjects[1])
			args.Push(cargoObj.Name)
			StringManagerFormatString(tempBuffer[:], StringIdMessageNoLongerAccepts, args)

		case MessageTypeNewCompany:
			args := FormatArguments{}
			company := CompanyManagerGet(CompanyId(msg.ItemSubjects[0]))
			args.Push(company.Name)
			args.Skip(2)
			town := TownManagerGet(TownId(msg.ItemSubjects[1]))
			args.Push(town.Name)
			StringManagerFormatString(tempBuffer[:], StringIdMessageNewTransportCompany, args)

		case MessageTypeUnableToLandAtAirport:
			args := FormatArguments{}
			head := EntityManagerGetVehicleHead(EntityId(msg.ItemSubjects[0]))
			if head == nil {
				break
			}
			args.Push(head.Name)
			args.Push(head.OrdinalNumber)
			station := StationManagerGet(StationId(msg.ItemSubjects[1]))
			args.Push(station.Name)
			args.Push(station.Town)
			StringManagerFormatString(tempBuffer[:], StringIdMessageNotAbleToLandAt, args)

		case MessageTypeCitizensCelebrate:
			args := FormatArguments{}
			cargoObj := ObjectManagerGetCargoObject(msg.ItemSubjects[2] >> 8)
			args.Push(cargoObj.Name)
			town := TownManagerGet(TownId(msg.ItemSubjects[2] & 0xFF))
			args.Push(town.Name)
			formatId := StringIdMessageFirstStringArriveAt
			if cargoObj.HasFlags(CargoObjectFlagDelivering) {
				formatId = StringIdMessageFirstStringDeliveryArrivesAt
			}
			StringManagerFormatString(tempBuffer[:], formatId, args)

		case MessageTypeWorkersCelebrate:
			args := FormatArguments{}
			cargoObj := ObjectManagerGetCargoObject(msg.ItemSubjects[2] >> 8)
			args.Push(cargoObj.Name)
			industry := IndustryManagerGet(IndustryId(msg.ItemSubjects[2] & 0xFF))
			args.Push(industry.Name)
			args.Push(industry.Town)
			StringManagerFormatString(tempBuffer[:], StringIdMessageWorkersCelebrate, args)

		// Other message types omitted for brevity
		default:
			// For unknown types, do nothing.
		}

		// Save the formatted text into the message if formatting was performed.
		// Assume StringManagerFormatString writes a NUL-terminated string in tempBuffer.
		// Convert to the message's backing storage
		if n := indexByte(tempBuffer[:], 0); n >= 0 {
			copy(msg.MessageString[:], tempBuffer[:n])
		} else {
			copy(msg.MessageString[:], tempBuffer[:])
		}
	}
}


// Post new message to player
// Source: MessageManager::post
func PostMessage(typ MessageType, companyId CompanyId, subject uint16, item uint16) {
	{
		// Build new message from inputs
		newMessage := Message{}
		newMessage.CompanyId = companyId
		newMessage.Type = typ
		newMessage.Date = getCurrentDay()
		newMessage.ItemSubjects[0] = subject
		newMessage.ItemSubjects[1] = item
		newMessage.ItemSubjects[2] = 0

		// Helper: equality that mirrors C++ operator== behaviour (company id ignored)
		messagesEqual := func(a, b *Message) bool {
			if a == nil || b == nil {
				return false
			}
			if a.Type != b.Type {
				return false
			}
			// Compare item subjects (array comparison)
			for i := 0; i < 3; i++ {
				if a.ItemSubjects[i] != b.ItemSubjects[i] {
					return false
				}
			}
			// Compare the stored message string bytes
			if string(a.MessageString[:]) != string(b.MessageString[:]) {
				return false
			}
			// Compare time active as it influences equality in practice
			if a.TimeActive != b.TimeActive {
				return false
			}
			return true
		}

		// Deduplicate when descriptor requests it
		if desc := getMessageTypeDescriptor(typ); desc.HasFlag(MessageTypeFlagsShouldDedup) {
			for i := 0; i < int(getNumMessages()); i++ {
				existing := &rawMessages()[i]
				if messagesEqual(existing, &newMessage) {
					// Found an identical message — do not post again
					return
				}
			}
		}

		// If buffer is full, remove the best candidate (oldest/expired)
		if int(getNumMessages()) >= LimitsMaxMessages {
			oldest := int32(-1)
			oldestIndex := -1

			// First pass: prefer messages that are active (TimeActive != 0)
			for i := 0; i < int(getNumMessages()); i++ {
				m := &rawMessages()[i]
				if m.TimeActive != 0 {
					age := int32(getMessageTypeDescriptor(m.Type).Duration) + int32(m.Date) - int32(getCurrentDay())
					if age > oldest {
						oldest = age
						oldestIndex = i
					}
				}
			}

			// If nothing found, consider all messages
			if oldestIndex == -1 {
				for i := 0; i < int(getNumMessages()); i++ {
					m := &rawMessages()[i]
					age := int32(getMessageTypeDescriptor(m.Type).Duration) + int32(m.Date) - int32(getCurrentDay())
					if age > oldest {
						oldest = age
						oldestIndex = i
					}
				}
			}

			if oldestIndex != -1 {
				// Convert index to MessageId for remove
				remove(MessageId(oldestIndex))
			}
		}

		// Append the new message into the raw message array.
		// To match original behaviour, copy the existing slot's messageString memory first.
		slot := int(getNumMessages())
		if slot < 0 || slot >= len(rawMessages()) {
			// Defensive: nothing we can do if underlying storage is inconsistent
			return
		}
		copy(newMessage.MessageString[:], rawMessages()[slot].MessageString[:])

		rawMessages()[slot] = newMessage
		setNumMessages(getNumMessages() + 1)

		// Prepare a temporary buffer for any localized formatting that may be needed.
		var tempBuffer [512]byte
		message := &rawMessages()[slot]

		// Formatting the human readable message text is done based on message type.
		// The detailed per-type formatting mirrors the original C++ logic and relies
		// on many external systems (entity manager, object manager, string manager).
		// Implementations of those are provided elsewhere; here we only drive them.
		switch message.Type {
		// Example: vehicle related message that needs the vehicle head name and ordinal
		case MessageTypeCantWaitForFullLoad:
			{
				// If referenced entity is missing, do not format
				head := EntityManagerGetVehicleHead(EntityId(message.ItemSubjects[0]))
				if head == nil {
					break
				}
				args := NewFormatArguments()
				args.Push(head.Name)
				args.Push(head.OrdinalNumber)

				station := StationManagerGet(StationId(message.ItemSubjects[1]))
				if station != nil {
					args.Push(station.Name)
					args.Push(station.Town)
				}
				StringManagerFormatString(tempBuffer[:], StringIdMessageNotAllowedToWaitForFullLoadAt, args)
			}
		case MessageTypeIndustryClosingDown:
			{
				industry := IndustryManagerGet(IndustryId(message.ItemSubjects[0]))
				if industry == nil {
					break
				}
				args := NewFormatArguments()
				args.Push(industry.Name)
				args.Push(industry.Town)
				if obj := industry.GetObject(); obj != nil {
					StringManagerFormatString(tempBuffer[:], obj.NameClosingDownStringId(), args)
				}
			}
		// Additional cases would be implemented similarly, mapping to existing managers
		default:
			// For unknown or unimplemented types do nothing — leaving message string as-is.
		}

		// Note: Errors arising from lookups/formatting are intentionally not returned
		// because the original function was fire-and-forget; such errors should be
		// handled/logged by the called subsystems.
	}
}
