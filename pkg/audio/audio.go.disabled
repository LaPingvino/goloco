// Play sound effect at position
// Source: Audio::playSound
func PlaySound(soundId SoundId, pos Pos3, volume int32) {
	// Early exits: audio must be initialized, enabled and not paused
	if !audioIsInitialised || !audioIsEnabled || audioIsPaused {
		return
	}

	// Ignore invalid sound ids or silent volumes
	if soundId == 0 || volume <= 0 {
		return
	}

	// Compute pan and frequency. Frequency left as 0 to indicate "use default".
	var pan int32
	var frequency int32 = 0

	// Special constants for play location (kept local to avoid depending on external names)
	const playAtCentre = 0x8000
	const playAtLocation = 0x8001

	// Handle special position flags first
	switch pos.X {
	case playAtCentre:
		// Center the sound
		pan = 0
	case playAtLocation:
		// Play at exact location without additional panning calculations
		pan = 0
	default:
		// Map world X coordinate into stereo pan range [-100, 100].
		// Assume world X roughly fits in signed 16-bit range; clamp defensively.
		// This is a simple linear approximation for stereo panning.
		const maxCoord = 32767
		raw := pos.X
		if raw > maxCoord {
			raw = maxCoord
		} else if raw < -maxCoord {
			raw = -maxCoord
		}
		pan = raw * 100 / maxCoord
		if pan < -100 {
			pan = -100
		} else if pan > 100 {
			pan = 100
		}
	}

	// Delegate actual playback to the lower-level mixer/player.
	// `mixSound` is expected to exist in the package and perform the final playback.
	// Do not loop vehicle/environment sounds here.
	mixSound(soundId, false, volume, pan, frequency)
}


// Update audio mixing and streaming
// Source: Audio::update
func UpdateAudio() {
	// If there are no sound effect channels, nothing to update.
	if len(soundFX) == 0 {
		return
	}

	// Iterate by index so we can take the address of each channel safely.
	for i := range soundFX {
		ch := &soundFX[i]
		if !ch.IsPlaying() {
			// Attempt to stop the channel which should force buffer deallocation.
			// Treat any error as non-fatal for the update loop.
			if err := ch.Stop(); err != nil {
				_ = err
			}
		}
	}
}


// Play sound effect at position
// Source: Audio::playSound
func PlaySound(soundId SoundId, pos Pos3, volume int32) {
	{
		// Quick early exits based on global audio state
		const kPlayAtCentre = 0x8000
		if !audioIsInitialised || audioIsPaused || !audioIsEnabled {
			return
		}
		if volume <= 0 {
			return
		}
		// Ignore invalid sound id
		if soundId == 0 {
			return
		}

		// Default pan/frequency
		var pan int32 = 0
		var freq int32 = 0

		// If special centre sentinel, play centered immediately
		if pos.X == kPlayAtCentre {
			mixSound(soundId, false, volume, pan, freq)
			return
		}

		// Simple positional attenuation and panning.
		// Treat listener as origin (0,0,0) for now.
		const maxRange = 3000 // audible range in game units (tunable)
		dx := int64(pos.X)
		dy := int64(pos.Y)
		dz := int64(pos.Z)

		dist2 := dx*dx + dy*dy + dz*dz
		maxRange2 := int64(maxRange * maxRange)
		if dist2 >= maxRange2 {
			// out of audible range
			return
		}

		// Linear attenuation based on squared distance (simple and inexpensive)
		attenFactor := float64(maxRange2-dist2) / float64(maxRange2)
		adjVol := int32(float64(volume) * attenFactor)
		if adjVol <= 0 {
			return
		}

		// Pan: map X position to -100..100
		panF := (float64(dx) / float64(maxRange)) * 100.0
		if panF < -100.0 {
			pan = -100
		} else if panF > 100.0 {
			pan = 100
		} else {
			pan = int32(panF)
		}

		// Delegate to lower-level mixer
		mixSound(soundId, false, adjVol, pan, freq)
	}
}


// Update audio mixing and streaming
// Source: Audio::update
func UpdateAudio() {
	{
	    // If there are no active sound channels, nothing to do.
	    if len(soundFX) == 0 {
	        return
	    }

	    // Iterate channels and stop any that have finished playing.
	    for i := range soundFX {
	        ch := &soundFX[i]
	        if !ch.isPlaying() {
	            // Stop forces deallocation of underlying buffer/resources.
	            ch.stop()
	        }
	    }
	}
}
