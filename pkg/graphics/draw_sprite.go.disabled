		switch zoom {
		case 0:
			drawRLESprite(dc.RenderTarget(), args, op, 0)
		case 1:
			drawRLESprite(dc.RenderTarget(), args, op, 1)
		case 2:
			drawRLESprite(dc.RenderTarget(), args, op, 2)
		case 3:
			drawRLESprite(dc.RenderTarget(), args, op, 3)
		default:
			// Fallback to a generic RLE draw routine for unexpected zooms.
			drawRLESprite(dc.RenderTarget(), args, op, zoom)
		}
	} else {
		switch zoom {
		case 0:
			drawBMPSprite(dc.RenderTarget(), args, op, 0)
		case 1:
			drawBMPSprite(dc.RenderTarget(), args, op, 1)
		case 2:
