// Get G1 graphics element by ID from loaded data
// Source: Gfx::getG1Element
func GetG1Element(id uint32) *G1Element {
	// Return nil if elements are not loaded or id is out of range
	if len(g1Elements) == 0 {
		return nil
	}
	if id >= uint32(len(g1Elements)) {
		return nil
	}
	return &g1Elements[id]
}


// Load palette from G1 data with modifier for recoloring
// Source: Gfx::loadPalette
func LoadPalette(imageIndex uint32, modifier uint8) error {
	g1Palette := getG1Element(imageIndex)
	if g1Palette == nil {
		return fmt.Errorf("g1 element %d not found", imageIndex)
	}

	colourData := g1Palette.offset
	start := int(g1Palette.xOffset)
	end := start + int(g1Palette.width)

	// Basic bounds checks
	if start < 0 || end > len(_rgbaPalette) {
		return fmt.Errorf("palette index out of range (%d..%d)", start, end)
	}
	needed := (end - start) * 3
	if needed > len(colourData) {
		return fmt.Errorf("insufficient colour data: need %d got %d", needed, len(colourData))
	}

	ci := 0
	for i := start; i < end; i++ {
		// Scale each channel by modifier then divide by 256 (as in original code)
		b := (int(colourData[ci]) * int(modifier)) / 256
		ci++
		g := (int(colourData[ci]) * int(modifier)) / 256
		ci++
		r := (int(colourData[ci]) * int(modifier)) / 256
		ci++

		_rgbaPalette[i].b = uint8(b)
		_rgbaPalette[i].g = uint8(g)
		_rgbaPalette[i].r = uint8(r)
	}

	// Update the drawing engine's palette (start=10, count=236 as original)
	getDrawingEngine().updatePalette(_rgbaPalette, 10, 236)

	return nil
}


