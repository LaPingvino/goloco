// Get width of character in font
// Source: Gfx::getCharacterWidth
func GetCharacterWidth(font Font, char rune) int16 {
	// Map rune to font table index (space is 32). Return 0 on invalid input to avoid panics.
	idx := int(char) - 32
	if idx < 0 {
		return 0
	}

	base := getFontBaseIndex(font) / 224
	if base < 0 || base >= len(_characterWidths) {
		return 0
	}

	row := _characterWidths[base]
	if idx >= len(row) {
		return 0
	}

	return int16(row[idx])
}


// Calculate pixel width of string
// Source: getStringWidth
func GetStringWidth(text string, font Font) int16 {
	{
		// Sum the pixel widths of each printable character until a newline or NUL.
		var total int
		const maxInt16 = 1<<15 - 1

		for _, r := range text {
			// Stop at common string terminators (match C/C++ behaviour).
			if r == '\n' || r == '\r' || r == 0 {
				break
			}
			// GetCharacterWidth is provided elsewhere; cast result to int for accumulation.
			total += int(GetCharacterWidth(font, r))
			// Clamp to prevent overflow of int16 on return.
			if total >= maxInt16 {
				return int16(maxInt16)
			}
		}

		return int16(total)
	}
}
