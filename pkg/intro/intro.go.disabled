// Play intro sequence
// Source: Intro::play
func PlayIntro() {
	// Acquire a drawing context; if unavailable, abort early.
	ctx, err := getDrawingContext()
	if err != nil {
		return
	}
	defer endDrawingContext(ctx)

	// Drive the intro state machine.
	// Use package-level `introTicks` and state accessors `getState`/`setState`.
	// Timing thresholds are arbitrary but reasonable (can be tuned later).
	switch getState() {
	case StateNone:
		updateNone(ctx)

	case StateDisplayNoticeBegin:
		updateDisplayNoticeBegin(ctx)

	case StateDisplayNoticeBeginReset:
		// Load default palette and proceed to the notice display state.
		loadPalette(ImageIdsDefaultPalette, 0)
		setState(StateDisplayNotice)
		introTicks = 0

	case StateDisplayNotice:
		// Keep the notice on screen for a fixed duration then proceed to end.
		introTicks++
		if introTicks > 300 {
			setState(StateEnd)
			introTicks = 0
		}

	case StateEnd:
		updateEnd(ctx)

	case StateEnd2:
		updateEnd2(ctx)

	default:
		// Unknown state: reset intro to none to avoid getting stuck.
		setState(StateNone)
		updateNone(ctx)
	}

	// Commit any drawing changes (no-op if the backing implementation doesn't require it).
	present(ctx)
}
