// Start tutorial mode
// Source: Tutorial::start
func StartTutorial() {
	// initialize tutorial state
	state = StateStarting

	// default tutorial metadata
	tutorialString = StringId(0)
	tutorialNumber = 1

	// attempt to read the tutorial binary; use a simple default path.
	// The helper `readTutorialFile` is expected to return ([]uint16, error).
