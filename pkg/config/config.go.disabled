package config

// Auto-generated by batch_ai_impl using opencode + GPT-5-mini
// Original: Config.cpp

// Read configuration from file
// Source: Config::read
func ReadConfig() *Config {
	cfg := &Config{}

	// Locate config file: env override, then standard user config path, then local fallback.
	configPath := os.Getenv("OPENLOCO_CONFIG")
	if configPath == "" {
		home, err := os.UserHomeDir()
		if err == nil {
			configPath = filepath.Join(home, ".config", "goloco", "config.yaml")
		} else {
			configPath = "config.yaml"
		}
	}

	// Read file; if missing, try local fallback and otherwise return defaults.
	data, err := os.ReadFile(configPath)
	if err != nil {
		data, err = os.ReadFile("config.yaml")
		if err != nil {
			return cfg
		}
	}

	// Parse YAML into the config struct. On error, return the defaults.
	if err := yaml.Unmarshal(data, cfg); err != nil {
		return cfg
	}

	// Ensure shortcuts map is initialized to avoid nil-map panics downstream.
	if cfg.Shortcuts == nil {
		cfg.Shortcuts = make(map[int]KeyboardShortcut)
	}

	// Note: merging runtime defaults for missing shortcut entries happens elsewhere.
	return cfg
}


// Write configuration to file
// Source: Config::write
func (c *Config) Write() {
	{
		// Determine config file path and ensure parent directory exists.
		configPath := EnvironmentGetPathNoWarning(EnvironmentPathOpenlocoYML)
		dir := filepath.Dir(configPath)
		_ = os.MkdirAll(dir, 0o755)

		// Build YAML node as native Go maps so it mirrors the original YAML structure.
		node := make(map[string]any)

		// Display
		displayNode := make(map[string]any)
		displayNode["mode"] = c.Display.Mode
		if c.Display.Index != 0 {
			displayNode["index"] = c.Display.Index
		}
		displayNode["window_resolution"] = c.Display.WindowResolution
		displayNode["fullscreen_resolution"] = c.Display.FullscreenResolution
		node["display"] = displayNode

		// Audio
		audioNode := make(map[string]any)
		if audioDevice := c.Audio.Device; audioDevice != "" {
			audioNode["device"] = audioDevice
		}
		audioNode["mainVolume"] = c.Audio.MainVolume
		audioNode["playJukeboxMusic"] = c.Audio.PlayJukeboxMusic
		audioNode["play_title_music"] = c.Audio.PlayTitleMusic
		audioNode["playNewsSounds"] = c.Audio.PlayNewsSounds
		audioNode["playlist"] = c.Audio.Playlist
		audioNode["customJukebox"] = c.Audio.CustomJukebox
		node["audio"] = audioNode

		// Network
		networkNode := make(map[string]any)
		networkNode["enabled"] = c.Network.Enabled
		node["network"] = networkNode

		// General top-level paths
		node["loco_install_path"] = c.LocoInstallPath
		node["last_save_path"] = c.LastSavePath
		node["last_landscape_path"] = c.LastLandscapePath

		// Regional
		node["language"] = c.Language
		node["measurementFormat"] = c.MeasurementFormat
		node["preferredCurrency"] = c.PreferredCurrency
		node["usePreferredCurrencyForNewGames"] = c.UsePreferredCurrencyForNewGames
		node["usePreferredCurrencyAlways"] = c.UsePreferredCurrencyAlways

		// Display-related flags
		node["scale_factor"] = c.ScaleFactor
		node["showFPS"] = c.ShowFPS
		node["uncapFPS"] = c.UncapFPS

		// Rendering
		node["constructionMarker"] = c.ConstructionMarker
		node["gridlinesOnLandscape"] = c.GridlinesOnLandscape
		node["heightMarkerOffset"] = c.HeightMarkerOffset
		node["showHeightAsUnits"] = c.ShowHeightAsUnits
		node["landscapeSmoothing"] = c.LandscapeSmoothing
		node["vehiclesMinScale"] = c.VehiclesMinScale
		node["stationNamesMinScale"] = c.StationNamesMinScale

		// News settings
		newsNode := make(map[string]any)
		// Expect c.NewsSettings to be a map-like structure keyed by the message type names.
		newsNode["majorCompany"] = c.NewsSettings["majorCompany"]
		newsNode["majorCompetitor"] = c.NewsSettings["majorCompetitor"]
		newsNode["minorCompany"] = c.NewsSettings["minorCompany"]
		newsNode["minorCompetitor"] = c.NewsSettings["minorCompetitor"]
		newsNode["general"] = c.NewsSettings["general"]
		newsNode["advice"] = c.NewsSettings["advice"]
		node["news"] = newsNode

		// General UI
		node["allow_multiple_instances"] = c.AllowMultipleInstances
		node["cashPopupRendering"] = c.CashPopupRendering
		node["edgeScrolling"] = c.EdgeScrolling
		node["edgeScrollingSpeed"] = c.EdgeScrollingSpeed
		node["windowFrameStyle"] = c.WindowFrameStyle
		node["zoom_to_cursor"] = c.ZoomToCursor

		// Saving and autosaves
		node["autosave_amount"] = c.AutosaveAmount
		node["autosave_frequency"] = c.AutosaveFrequency
		node["exportObjectsWithSaves"] = c.ExportObjectsWithSaves

		// Cheats
		node["breakdowns_disabled"] = c.BreakdownsDisabled
		node["buildLockedVehicles"] = c.BuildLockedVehicles
		node["cheats_menu_enabled"] = c.CheatsMenuEnabled
		node["companyAIDisabled"] = c.CompanyAIDisabled
		node["disableVehicleLoadPenaltyCheat"] = c.DisableVehicleLoadPenaltyCheat
		node["displayLockedVehicles"] = c.DisplayLockedVehicles
		node["invertRightMouseViewPan"] = c.InvertRightMouseViewPan
		node["townGrowthDisabled"] = c.TownGrowthDisabled
		node["trainsReverseAtSignals"] = c.TrainsReverseAtSignals
		node["disableStationSizeLimit"] = c.DisableStationSizeLimit
		node["showAiPlanningAsGhosts"] = c.ShowAiPlanningAsGhosts

		// Preferred owner
		node["preferredOwnerName"] = c.PreferredOwnerName
		node["usePreferredOwnerName"] = c.UsePreferredOwnerName
		node["preferredOwnerFace"] = c.PreferredOwnerFace
		node["usePreferredOwnerFace"] = c.UsePreferredOwnerFace

		// Shortcuts
		scNode := make(map[string]any)
		shortcutDefs := InputShortcutManagerGetList()
		for _, def := range shortcutDefs {
			if val, ok := c.Shortcuts[def.ID]; ok {
				scNode[def.ConfigName] = val
			} else {
				scNode[def.ConfigName] = ""
			}
		}
		node["shortcuts"] = scNode

		// Misc settings
		node["scenarioSelectedTab"] = c.ScenarioSelectedTab

		// Marshal to YAML (matches original format) and write to file.
		// Use YAML if available; fall back to JSON if marshal fails.
		var out []byte
		if data, err := yaml.Marshal(node); err == nil {
			out = append(data, '\n')
		} else if data, err := json.MarshalIndent(node, "", "  "); err == nil {
			out = append(data, '\n')
		} else {
			// If both marshals fail, log and return.
			log.Printf("failed to marshal config to YAML/JSON")
			return
		}

		if err := os.WriteFile(configPath, out, 0o644); err != nil {
			log.Printf("failed to write config file %s: %v", configPath, err)
		}
	}
}
