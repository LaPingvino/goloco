+        // OPENLOCO_BUILDTRACE=1: each applied placement, its tick and callers (goloco comparison)
+        if (std::getenv("OPENLOCO_BUILDTRACE") != nullptr && hasFlags(flags, Flags::apply))
+        {
+            void* frames[6] = { __builtin_return_address(0), __builtin_return_address(1), __builtin_return_address(2), __builtin_return_address(3), __builtin_return_address(4), __builtin_return_address(5) };
