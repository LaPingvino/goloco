+            for (auto* f : frames)
+            {
+                Dl_info info{};
+                if (f != nullptr && dladdr(f, &info) != 0)
+                {
+                    std::fprintf(stderr, " 0x%zx", static_cast<size_t>(static_cast<char*>(f) - static_cast<char*>(info.dli_fbase)) - 1);
+                }
+            }
+            std::fprintf(stderr, "\n");
+        }
         regs.ebx = createBuilding(args, flags);
