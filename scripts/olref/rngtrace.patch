+    // OPENLOCO_RNGTRACE=FROM,TO: every gPrng1 draw in scenario ticks FROM..TO
+    // goes to stderr with the tick and the callers' offsets in the binary
+    // (addr2line -f -C -e OpenLoco 0x…).
+    static uint32_t _traceFrom, _traceTo;
+    [[gnu::noinline]] static void traceHook(Core::Prng& p)
+    {
+        if (&p != &getGameState().rng)
+        {
+            return;
+        }
+        auto t = ScenarioManager::getScenarioTicks();
+        if (t < _traceFrom || t > _traceTo)
+        {
+            return;
+        }
+        void* frames[4] = { __builtin_return_address(1), __builtin_return_address(2), __builtin_return_address(3), __builtin_return_address(4) };
+        std::fprintf(stderr, "RNG %u", t);
+        for (auto* f : frames)
+        {
+            Dl_info info{};
+            if (f != nullptr && dladdr(f, &info) != 0)
+            {
+                std::fprintf(stderr, " 0x%zx", static_cast<size_t>(static_cast<char*>(f) - static_cast<char*>(info.dli_fbase)) - 1);
+            }
+        }
+        std::fprintf(stderr, "\n");
+    }
+    static struct TraceInit
+    {
+        TraceInit()
+        {
+            if (const char* e = std::getenv("OPENLOCO_RNGTRACE"); e != nullptr && std::sscanf(e, "%u,%u", &_traceFrom, &_traceTo) == 2)
+            {
+                Core::gPrngTraceHook = traceHook;
+            }
+        }
+    } _traceInit;
