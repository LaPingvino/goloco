+    void (*gPrngTraceHook)(Prng&) = nullptr; // rng trace (goloco comparison)
+
     uint32_t Prng::randNext()
     {
+        if (gPrngTraceHook != nullptr)
+        {
+            gPrngTraceHook(*this);
+        }
